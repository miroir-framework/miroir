{
  "name": "miroir-ai",
  "version": "0.5.0-rc.1",
  "description": "LLM/AI assistant backend for Miroir Framework — CopilotKit Runtime endpoint exposing Miroir element generation tools",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup --target=node20 --format esm src/index.ts --dts",
    "devBuild": "npm run build",
    "dev": "npm run build && node ./dist/index.js",
    "test": "cross-env NODE_ENV=test vitest run --bail=1",
    "testByFile": "cross-env NODE_ENV=test vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "keywords": [
    "ai",
    "llm",
    "copilotkit",
    "miroir",
    "framework"
  ],
  "dependencies": {
    "@ag-ui/client": "1.0.0",
    "@ag-ui/core": "0.0.59",
    "@ai-sdk/openai": "3.0.65",
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@anthropic-ai/sdk": "0.128.0",
    "@bufbuild/protobuf": "1.10.0",
    "@connectrpc/connect": "1.7.0",
    "@connectrpc/connect-node": "1.7.0",
    "@connectrpc/connect-web": "1.7.0",
    "@copilotkit/runtime": "1.74.0",
    "@cursor/sdk": "1.0.32",
    "@google/generative-ai": "0.24.1",
    "@statsig/js-client": "3.33.5",
    "express": "5.2.1",
    "loglevelnext": "6.0.0",
    "miroir-app-miroir": "*",
    "miroir-core": "*",
    "miroir-example-library": "*",
    "openai": "7.27.0",
    "rxjs": "7.8.2",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "cross-env": "10.1.0",
    "tsup": "8.5.1",
    "vitest": "5.0.2"
  }
}
