{
  "name": "miroir-core",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "The core Miroir components. Without it, Miroir will not work.",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model-validation-fs": {
      "types": "./dist/model-validation-fs.d.ts",
      "import": "./dist/model-validation-fs.js"
    },
    "./ml-to-ts": {
      "types": "./dist/ml-to-ts.d.ts",
      "import": "./dist/ml-to-ts.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "LICENSE.md",
    "package.json",
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/model-validation-fs.js",
    "dist/model-validation-fs.js.map",
    "dist/ml-to-ts.js",
    "dist/ml-to-ts.js.map",
    "dist/src/worker.js"
  ],
  "scripts": {
    "copy-files": "copyfiles -u 1 src/**/*.json src/**/*.css dist/src",
    "build": "npm run copy-files && tsup",
    "devBuild": "npm run generate-ts-types && echo DONE PRE-BUILD && npm run build",
    "generate-ts-types": "tsx ./scripts/generate-ts-types.ts",
    "testByFileBailOut": "vitest run --maxWorkers=1 --reporter=verbose --bail=1",
    "testByFile": "vitest run --maxWorkers=1 --reporter=verbose",
    "testMiroir": "tsx ./scripts/test-miroir-core.ts",
    "testByFileWithFullLog": "cross-env DEBUG='vite-node:*' vitest run --maxWorkers=1",
    "test": "vitest run -t"
  },
  "browser": {
    "os": false,
    "path": false
  },
  "dependencies": {
    "@miroir-framework/jzod": "1.0.0",
    "@miroir-framework/jzod-ts": "1.0.0",
    "chalk": "6.0.1",
    "diff": "9.0.0",
    "fast-deep-equal": "3.1.3",
    "fast-json-stable-stringify": "2.1.0",
    "json-diff": "1.0.6",
    "miroir-app-admin": "*",
    "miroir-app-miroir": "*",
    "mustache": "4.2.0",
    "serialize-error": "13.0.2",
    "uuid": "14.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-attributes": "7.29.7",
    "@babel/preset-typescript": "8.0.7",
    "@rollup/plugin-commonjs": "29.0.3",
    "@types/jest": "30.0.0",
    "@types/json-diff": "1.0.3",
    "@types/mustache": "4.2.6",
    "@types/node": "26.6.5",
    "copyfiles": "2.4.1",
    "jest": "30.5.2",
    "miroir-store-bundled": "*",
    "miroir-store-filesystem": "*",
    "miroir-store-postgres": "*",
    "miroir-example-library": "*",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "tinyrainbow": "3.2.0",
    "ts-add-js-extension": "1.6.6",
    "ts-node": "10.9.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
