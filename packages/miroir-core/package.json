{
  "name": "miroir-core",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "The core Miroir components. Without it, Miroir will not work.",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model-validation-fs": {
      "types": "./dist/model-validation-fs.d.ts",
      "import": "./dist/model-validation-fs.js"
    },
    "./ml-to-ts": {
      "types": "./dist/ml-to-ts.d.ts",
      "import": "./dist/ml-to-ts.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "LICENSE.md",
    "package.json",
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/model-validation-fs.js",
    "dist/model-validation-fs.js.map",
    "dist/ml-to-ts.js",
    "dist/ml-to-ts.js.map",
    "dist/src/worker.js"
  ],
  "scripts": {
    "copy-files": "copyfiles -u 1 src/**/*.json src/**/*.css dist/src",
    "build": "npm run copy-files && tsup",
    "devBuild": "npm run generate-ts-types && echo DONE PRE-BUILD && npm run build",
    "generate-ts-types": "tsx ./scripts/generate-ts-types.ts",
    "testByFileBailOut": "vitest run --poolOptions.forks.singleFork --reporter=verbose --bail=1",
    "testByFile": "vitest run --poolOptions.forks.singleFork --reporter=verbose",
    "testMiroir": "tsx ./scripts/test-miroir-core.ts",
    "testByFileWithFullLog": "cross-env DEBUG='vite-node:*' vitest run --poolOptions.forks.singleFork",
    "test": "vitest run --poolOptions.threads.singleThread -t"
  },
  "browser": {
    "os": false,
    "path": false
  },
  "dependencies": {
    "@miroir-framework/jzod": "0.8.5",
    "chalk": "5.4.1",
    "diff": "8.0.3",
    "fast-deep-equal": "3.1.3",
    "fast-json-stable-stringify": "2.1.0",
    "json-diff": "1.0.6",
    "miroir-test-app_deployment-admin": "*",
    "miroir-test-app_deployment-miroir": "*",
    "mustache": "4.2.0",
    "serialize-error": "12.0.0",
    "uuid": "11.1.0",
    "yaml": "2.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-attributes": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@miroir-framework/jzod-ts": "0.8.5",
    "@rollup/plugin-commonjs": "28.0.5",
    "@types/diff": "7.0.2",
    "@types/jest": "29.5.14",
    "@types/json-diff": "1.0.3",
    "@types/mustache": "4.2.6",
    "@types/node": "22.19.17",
    "copyfiles": "2.4.1",
    "jest": "29.7.0",
    "miroir-store-bundled": "*",
    "miroir-store-filesystem": "*",
    "miroir-store-postgres": "*",
    "miroir-test-app_deployment-library": "*",
    "pg": "8.16.0",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "tinyrainbow": "1.2.0",
    "ts-add-js-extension": "1.6.6",
    "ts-node": "10.9.2",
    "tsup": "8.5.1",
    "tsx": "4.20.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
