{
  "name": "miroir-app-meta",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "Meta application of the Miroir Framework: data about its development process (bundle size history)",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "package.json",
    "index.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "dist/assets/**/*.json"
  ],
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "test": "vitest run -t",
    "testByFile": "vitest run --maxWorkers=1 --reporter=verbose"
  },
  "nx": {
    "implicitDependencies": [
      "!miroir-core"
    ]
  },
  "devDependencies": {
    "miroir-core": "*",
    "miroir-app-admin": "*",
    "miroir-app-miroir": "*",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
