{
  "name": "miroir-localcache-redux",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "The Miroir implementation of Local Cache and Remote Access based on Redux.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "watch": "lerna watch --scope='miroir-localcache-redux' --include-dependencies -- lerna run build --scope='miroir-localcache-redux'",
    "build": "tsup",
    "devBuild": "npm run build",
    "copy-files": "copyfiles -u 1 src/**/*.json src/**/*.css dist/src",
    "test": "cross-env NODE_ENV=test jest --verbose --debug --silent=false -t",
    "vitest": "vitest run --passWithNoTests"
  },
  "tsup": {
    "dts": true,
    "clean": true,
    "bundle": true,
    "treeshake": true,
    "target": "node20",
    "format": [
      "esm"
    ],
    "entry": [
      "src/index.ts",
      "src/node.ts"
    ],
    "external": [
      "fs",
      "react",
      "react-dom",
      "react-redux"
    ]
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-redux": "^9.3.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "@teroneko/redux-saga-promise": "4.0.0",
    "immer": "11.1.21",
    "@miroir-framework/core": "*",
    "redux-saga": "1.5.1",
    "typed-redux-saga": "1.5.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "30.0.0",
    "babel-loader": "10.1.1",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "happy-dom": "21.0.4",
    "miroir-example-library": "*",
    "react": "18.3.1",
    "react-redux": "9.3.0",
    "rimraf": "6.1.3",
    "ts-loader": "9.6.2",
    "tsconfig-paths": "4.2.0",
    "tsup": "9.0.0",
    "vite": "8.3.5",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "5.0.5"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-localcache-redux"
  }
}
