{
  "name": "@miroir-framework/cli",
  "version": "0.5.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Command Line Interface for Miroir Framework - exposes Endpoint Actions as CLI commands",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "type": "module",
  "bin": {
    "miroir-cli": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-cli"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cli",
    "miroir",
    "framework",
    "command-line"
  ],
  "scripts": {
    "build": "tsup --target=node20 --format esm src/index.ts",
    "devBuild": "npm run build",
    "dev": "npm run build && node ./dist/index.js",
    "test": "cross-env NODE_ENV=test vitest run --bail=1",
    "testByFile": "cross-env NODE_ENV=test vitest run"
  },
  "dependencies": {
    "commander": "15.0.0",
    "loglevelnext": "6.0.0",
    "@miroir-framework/core": "*",
    "@miroir-framework/env": "*",
    "miroir-localcache-redux": "*"
  },
  "peerDependencies": {
    "@miroir-framework/store-filesystem": "*",
    "@miroir-framework/store-indexeddb": "*",
    "@miroir-framework/store-postgres": "*",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@miroir-framework/store-filesystem": {
      "optional": true
    },
    "@miroir-framework/store-indexeddb": {
      "optional": true
    },
    "@miroir-framework/store-postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/uuid": "11.0.0",
    "cross-env": "10.1.0",
    "miroir-app-admin": "*",
    "miroir-app-miroir": "*",
    "miroir-example-library": "*",
    "tsup": "9.0.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
