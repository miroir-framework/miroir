{
  "name": "miroir-cli",
  "version": "0.5.0-rc.1",
  "description": "Command Line Interface for Miroir Framework - exposes Endpoint Actions as CLI commands",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "miroir-cli": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "keywords": [
    "cli",
    "miroir",
    "framework",
    "command-line"
  ],
  "scripts": {
    "build": "tsup --target=node20 --format esm src/index.ts",
    "devBuild": "npm run build",
    "dev": "npm run build && node ./dist/index.js",
    "test": "cross-env NODE_ENV=test vitest run --poolOptions.threads.singleThread --bail=1",
    "testByFile": "cross-env NODE_ENV=test vitest run"
  },
  "dependencies": {
    "commander": "15.0.0",
    "loglevelnext": "6.0.0",
    "miroir-app-admin": "*",
    "miroir-app-miroir": "*",
    "miroir-core": "*",
    "miroir-env": "*",
    "miroir-example-library": "*",
    "miroir-localcache-redux": "*",
    "uuid": "11.1.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "miroir-store-filesystem": "*",
    "miroir-store-indexedDb": "*",
    "miroir-store-postgres": "*"
  },
  "peerDependenciesMeta": {
    "miroir-store-filesystem": {
      "optional": true
    },
    "miroir-store-indexedDb": {
      "optional": true
    },
    "miroir-store-postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/uuid": "10.0.0",
    "cross-env": "7.0.3",
    "miroir-example-library": "*",
    "tsup": "8.5.1",
    "vitest": "3.2.7"
  }
}
