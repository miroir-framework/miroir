{
  "name": "miroir-server",
  "version": "0.5.0-rc.1",
  "description": "server for mirroir-based front-end",
  "main": "server.js",
  "type": "module",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/XXXXXXXXXXXXXXXXXXXXXXXXX/issues"
  },
  "homepage": "https://github.com/XXXXXXXXXXXXXXXXXXXXXXXXXXX#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XXXXXXXXXXXXXXXXXXXXXXXX.git"
  },
  "scripts": {
    "build:client": "cross-env NODE_OPTIONS=--max-old-space-size=6144 npm run build -w miroir-standalone-app",
    "copy:client": "node scripts/copy-client.mjs",
    "copy:release-config": "copyfiles -u 1 config/**/*.json release/config",
    "build:server:OLD": "tsup --target=node20 --format esm src/server.ts --outDir dist",
    "build:server": "cross-env NODE_OPTIONS=--max-old-space-size=6144 npx @vercel/ncc build src/server.ts -o release/ -e miroir-core -e miroir-localcache-redux -e miroir-ai -e miroir-mcp -e miroir-store-filesystem -e miroir-store-indexedDb -e miroir-store-mongodb -e miroir-store-postgres -e miroir-app-admin -e miroir-example-library -e miroir-app-miroir -e json-diff",
    "build:release": "npm run copy:release-config && npm run build:server && npm run copy:client -- --if-present",
    "run:prod": "cross-env NODE_ENV=production node release/index.js",
    "help": "vite-node -h",
    "copy-files": "copyfiles -u 1 src/**/*.json src/**/*.css dist/src",
    "copy-config": "copyfiles -u 1 config/**/*.json dist/config",
    "copy-all": "npm run copy-files && npm run copy-config",
    "build-tsupNOK": "npm run copy-all && cross-env NODE_OPTIONS=--max-old-space-size=4096 npx ../../node_modules/.bin/tsup --target=node20 --format esm src/server.ts",
    "build:devNOK": "npm run build-tsupNOK",
    "buildNOK": "npm run build:devNOK",
    "devBuildNOK": "npm run buildNOK",
    "run:devNOK": "cross-env NODE_ENV=development nodemon ./release/server.js",
    "test": "cross-env NODE_ENV=test vitest",
    "testByFile": "cross-env NODE_ENV=test vitest run"
  },
  "nodemonConfig": {
    "ignore": [
      "**/test/**",
      "**/tests/**",
      "**/docs/**"
    ]
  },
  "dependencies": {
    "body-parser": "1.20.4",
    "cors": "2.8.6",
    "cross-fetch": "4.1.0",
    "diff": "9.0.0",
    "express": "4.22.1",
    "http-proxy-middleware": "3.0.7",
    "isomorphic-git": "1.42.2",
    "json-diff": "1.0.6",
    "loglevelnext": "6.0.0",
    "miroir-ai": "*",
    "miroir-core": "*",
    "miroir-env": "*",
    "miroir-localcache-redux": "*",
    "miroir-mcp": "*",
    "miroir-store-filesystem": "*",
    "miroir-store-indexedDb": "*",
    "miroir-store-mongodb": "*",
    "miroir-store-postgres": "*",
    "miroir-app-admin": "*",
    "miroir-example-library": "*",
    "miroir-app-miroir": "*"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.27.2",
    "@babel/register": "8.0.6",
    "@types/body-parser": "1.19.6",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "26.6.2",
    "@vercel/ncc": "0.45.0",
    "babel-loader": "10.1.1",
    "nodemon": "3.1.14",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsup": "8.5.1",
    "vite-plugin-node": "7.0.0",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1",
    "webpack-node-externals": "3.0.0"
  }
}
