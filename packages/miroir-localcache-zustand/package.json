{
  "name": "miroir-localcache-zustand",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "The Miroir implementation of Local Cache and Remote Access based on Zustand.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "vitest": "vitest run --passWithNoTests"
  },
  "tsup": {
    "dts": true,
    "clean": false,
    "bundle": true,
    "treeshake": true,
    "target": "node20",
    "format": [
      "esm"
    ],
    "entry": [
      "src/index.ts"
    ],
    "external": [
      "fs"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "fast-deep-equal": "3.1.3",
    "immer": "11.1.21",
    "lodash": "4.18.1",
    "miroir-app-miroir": "*",
    "miroir-core": "*",
    "miroir-example-library": "*",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "rimraf": "6.1.3",
    "tsconfig-paths": "4.2.0",
    "tsup": "8.5.1",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
