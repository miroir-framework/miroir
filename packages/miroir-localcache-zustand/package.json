{
  "name": "miroir-localcache-zustand",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "The Miroir implementation of Local Cache and Remote Access based on Zustand.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-localcache-zustand"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "vitest": "vitest run --passWithNoTests"
  },
  "tsup": {
    "dts": true,
    "clean": false,
    "bundle": true,
    "treeshake": true,
    "target": "node20",
    "format": [
      "esm"
    ],
    "entry": [
      "src/index.ts",
      "src/node.ts"
    ],
    "external": [
      "fs",
      "react",
      "react-dom"
    ]
  },
  "dependencies": {
    "@miroir-framework/core": "*",
    "@reduxjs/toolkit": "2.14.0",
    "immer": "11.2.9",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "miroir-example-library": "*",
    "react": "18.3.1",
    "rimraf": "6.1.4",
    "tsconfig-paths": "4.2.0",
    "tsup": "9.0.0",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  }
}
