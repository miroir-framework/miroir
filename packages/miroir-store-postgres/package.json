{
  "name": "miroir-store-postgres",
  "private": true,
  "version": "0.5.0-rc.1",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "description": "The Miroir implementation for accessing Postgres databases.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "watch": "lerna watch --scope='miroir-store-postgres' --include-dependencies -- lerna run build --scope='miroir-store-postgres'",
    "build-tsup": "tsup",
    "build": "npm run build-tsup",
    "devBuild": "npm run build",
    "copy-files": "copyfiles -u 1 src/**/*.json src/**/*.css dist/src",
    "test": "jest --verbose --silent=false -t",
    "vitest": "cross-env VITE_TEST_MODE='true' vitest run --reporter=verbose --maxWorkers=1 --bail=1",
    "generate-ts-types": "tsx ./scripts/postgres-generate-ts-types.ts"
  },
  "dependencies": {
    "miroir-core": "*",
    "miroir-app-miroir": "*",
    "pg": "8.23.0",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.27.1",
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.14",
    "copyfiles": "2.4.1",
    "loglevelnext": "6.0.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.14",
    "tsconfig-paths": "4.2.0",
    "tsup": "8.5.1"
  }
}
