{
  "name": "@miroir-framework/store-postgres",
  "private": true,
  "version": "0.5.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "description": "The Miroir implementation for accessing Postgres databases.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "module": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "watch": "lerna watch --scope='@miroir-framework/store-postgres' --include-dependencies -- lerna run build --scope='@miroir-framework/store-postgres'",
    "build-tsup": "tsup",
    "build": "npm run build-tsup",
    "devBuild": "npm run build",
    "copy-files": "copyfiles -u 1 src/**/*.json src/**/*.css dist/src",
    "test": "jest --verbose --silent=false -t",
    "vitest": "cross-env VITE_TEST_MODE='true' vitest run --reporter=verbose --maxWorkers=1 --bail=1",
    "generate-ts-types": "tsx ./scripts/postgres-generate-ts-types.ts"
  },
  "dependencies": {
    "miroir-app-miroir": "*",
    "@miroir-framework/core": "*",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8"
  },
  "devDependencies": {
    "@babel/preset-typescript": "8.0.7",
    "@jest/globals": "29.7.0",
    "@types/jest": "30.0.0",
    "copyfiles": "2.4.1",
    "loglevelnext": "6.0.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.15",
    "tsconfig-paths": "4.2.0",
    "tsup": "9.0.0",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-store-postgres"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  }
}
