{
  "name": "miroir-app-miroir",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "Miroir deployment assets (miroir_model and miroir_data) for the Miroir Framework",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE.md",
    "package.json",
    "index.d.ts",
    "dist/index.js",
    "dist/index.js.map"
  ],
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "test": "vitest run -t",
    "testByFile": "vitest run --maxWorkers=1 --reporter=verbose"
  },
  "nx": {
    "implicitDependencies": [
      "!@miroir-framework/core"
    ]
  },
  "devDependencies": {
    "copyfiles": "2.4.1",
    "@miroir-framework/core": "*",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-app-miroir"
  }
}
