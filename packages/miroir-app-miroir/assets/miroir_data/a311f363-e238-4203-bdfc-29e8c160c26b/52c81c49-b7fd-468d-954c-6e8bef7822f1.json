    "miroirTests": [
      {
        "miroirTestType": "reportTestSuite",
        "miroirTestLabel": "Runners page freeze Runner",
        "report": {
          "application": "360fcf1f-f0d4-4f8a-9262-07886e70fa15",
          "applicationSection": "data",
          "reportUuid": "ac75382d-00fc-4f93-a169-3f76ef85834e"
        },
        "miroirTests": [
          {
            "miroirTestType": "reportTest",
            "miroirTestLabel": "shows a refused freeze inline",
            "steps": [
              {
                "step": "expectElement",
                "label": "the freeze Runner is on the Runners page",
                "target": {
                  "widget": "selectState",
                  "field": "freezeApplicationVersion.application"
                },
                "timeout": 15000
              },
              {
                "step": "openSelect",
                "label": "open the application picker",
                "field": "freezeApplicationVersion.application"
              },
              {
                "step": "click",
                "label": "pick appForTest",
                "target": {
                  "byLabelText": "freezeApplicationVersion.application-option-eef01001-0001-4000-8000-000000000001"
                }
              },
              {
                "step": "waitForAttribute",
                "label": "appForTest is picked",
                "target": {
                  "widget": "selectState",
                  "field": "freezeApplicationVersion.application"
                },
                "attribute": "data-test-selected-value",
                "value": "eef01001-0001-4000-8000-000000000001",
                "timeout": 2000
              },
              {
                "step": "change",
                "label": "reuse the label of the seeded version",
                "target": {
                  "byRole": "textbox",
                  "fieldName": "freezeApplicationVersion.versionName"
                },
                "value": "Initial"
              },
              {
                "step": "click",
                "label": "run the freeze",
                "target": {
                  "byRole": "button",
                  "name": "Freeze Application Version"
                }
              },
              {
                "step": "expectElement",
                "label": "the refusal is shown under the Runner",
                "target": {
                  "byTestId": "runner-error-freezeApplicationVersion"
                },
                "containsHtml": "already exists for this application and branch",
                "timeout": 15000
              }
            ]
          }
        ]
      }
    ]
