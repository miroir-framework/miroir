  "branch": "ad1ddc4e-556e-4598-9cff-706a2bde0be7",
  "description": "Deployment configurations derived from an environment definition: live sections on package assets, copy sections in .miroir/<environment>/, database stores named after the environment.",
  "tags": [
    "unit",
    "tools"
  ],
  "issue": "321",
  "definition": {
    "miroirTestType": "miroirTestSuite",
    "miroirTestLabel": "fn.environment.deriveDeployments",
    "miroirTests": [
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "live filesystem sections point at the package assets",
        "functionRef": {
          "module": "miroir-core/1_core/environment/Environment",
          "export": "deriveEnvironmentDeployments"
        },
        "arguments": [
          {
            "applications": {
              "library": {
                "package": "miroir-example-library",
                "selfApplication": "5af03c98-fe5e-490b-b08f-e1230971c57f",
                "deployment": "f714bb2f-a12d-4e71-a03b-74dcedea6eb4",
                "store": "filesystem",
                "mode": "live"
              }
            }
          },
          "dev"
        ],
        "expectedValue": {
          "status": "ok",
          "deployments": [
            {
              "applicationKey": "library",
              "package": "miroir-example-library",
              "deployment": "f714bb2f-a12d-4e71-a03b-74dcedea6eb4",
              "selfApplication": "5af03c98-fe5e-490b-b08f-e1230971c57f",
              "configuration": {
                "admin": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-example-library/assets"
                },
                "model": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-example-library/assets/library_model"
                },
                "data": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-example-library/assets/library_data"
                }
              }
            }
          ]
        }
      },
      {
