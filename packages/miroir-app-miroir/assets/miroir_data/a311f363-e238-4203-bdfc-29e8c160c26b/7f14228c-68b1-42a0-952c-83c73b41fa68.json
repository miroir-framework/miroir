                "modelVersion": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-app-miroir/assets/miroir_modelVersion"
                }
              }
            }
          ]
        }
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "assetPrefix replaces the application key in live directory names",
