      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "an application set to null is not installed",
        "functionRef": {
          "module": "miroir-core/1_core/environment/Environment",
          "export": "deriveEnvironmentDeployments"
        },
        "arguments": [
          {
            "applications": {
              "library": null
            }
          },
          "dev"
        ],
        "expectedValue": {
          "status": "ok",
          "deployments": []
        }
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "live needs the filesystem store",
        "functionRef": {
          "module": "miroir-core/1_core/environment/Environment",
          "export": "deriveEnvironmentDeployments"
        },
        "arguments": [
          {
            "applications": {
              "library": {
                "package": "miroir-example-library",
                "selfApplication": "5af03c98-fe5e-490b-b08f-e1230971c57f",
                "deployment": "f714bb2f-a12d-4e71-a03b-74dcedea6eb4",
                "store": "sql",
                "mode": "live"
              }
            }
          },
          "dev"
        ],
        "expectedValue": {
          "status": "error",
          "errors": [
            "application \"library\", section \"admin\": mode \"live\" needs store \"filesystem\", got \"sql\"",
            "application \"library\", section \"model\": mode \"live\" needs store \"filesystem\", got \"sql\"",
            "application \"library\", section \"data\": mode \"live\" needs store \"filesystem\", got \"sql\""
          ]
        }
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "a sql application gets schemas named after the environment and the application",
        "functionRef": {
          "module": "miroir-core/1_core/environment/Environment",
          "export": "deriveEnvironmentDeployments"
        },
        "arguments": [
          {
            "connections": {
              "postgres": {
                "host": "localhost",
                "passwordEnv": "MIROIR_POSTGRES_PASSWORD"
              }
            },
            "applications": {
              "library": {
                "package": "miroir-example-library",
                "selfApplication": "5af03c98-fe5e-490b-b08f-e1230971c57f",
                "deployment": "f714bb2f-a12d-4e71-a03b-74dcedea6eb4",
                "store": "sql",
                "mode": "copy",
                "sections": {
                  "modelVersion": {}
                }
              }
            }
          },
          "test-sql"
        ],
        "expectedValue": {
          "status": "ok",
          "deployments": [
            {
              "applicationKey": "library",
              "package": "miroir-example-library",
              "deployment": "f714bb2f-a12d-4e71-a03b-74dcedea6eb4",
              "selfApplication": "5af03c98-fe5e-490b-b08f-e1230971c57f",
              "configuration": {
                "admin": {
                  "emulatedServerType": "sql",
                  "connectionString": "postgres://postgres@localhost:5432/postgres",
                  "schema": "test_sql_library_admin",
                  "forceNullOptionalAttributeToUndefined": true
                },
                "model": {
                  "emulatedServerType": "sql",
                  "connectionString": "postgres://postgres@localhost:5432/postgres",
                  "schema": "test_sql_library",
                  "forceNullOptionalAttributeToUndefined": true
                },
                "data": {
                  "emulatedServerType": "sql",
                  "connectionString": "postgres://postgres@localhost:5432/postgres",
                  "schema": "test_sql_library",
                  "forceNullOptionalAttributeToUndefined": true
                },
                "modelVersion": {
                  "emulatedServerType": "sql",
                  "connectionString": "postgres://postgres@localhost:5432/postgres",
                  "schema": "test_sql_library_modelVersion",
                  "forceNullOptionalAttributeToUndefined": true
                }
              }
            }
          ]
        }
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "a mongodb application gets databases named after the environment and the application",
        "functionRef": {
          "module": "miroir-core/1_core/environment/Environment",
          "export": "deriveEnvironmentDeployments"
        },
        "arguments": [
          {
            "connections": {
              "mongodb": {
                "url": "mongodb://localhost:27017/"
              }
            },
            "applications": {
              "library": {
                "package": "miroir-example-library",
                "selfApplication": "5af03c98-fe5e-490b-b08f-e1230971c57f",
                "deployment": "f714bb2f-a12d-4e71-a03b-74dcedea6eb4",
                "store": "mongodb",
                "mode": "copy"
              }
            }
          },
          "test-mongodb"
        ],
        "expectedValue": {
          "status": "ok",
          "deployments": [
            {
              "applicationKey": "library",
              "package": "miroir-example-library",
              "deployment": "f714bb2f-a12d-4e71-a03b-74dcedea6eb4",
              "selfApplication": "5af03c98-fe5e-490b-b08f-e1230971c57f",
              "configuration": {
                "admin": {
                  "emulatedServerType": "mongodb",
                  "connectionString": "mongodb://localhost:27017/",
                  "database": "test_mongodb_library_admin"
                },
                "model": {
                  "emulatedServerType": "mongodb",
                  "connectionString": "mongodb://localhost:27017/",
                  "database": "test_mongodb_library"
                },
                "data": {
                  "emulatedServerType": "mongodb",
                  "connectionString": "mongodb://localhost:27017/",
                  "database": "test_mongodb_library"
                }
              }
            }
          ]
        }
      },
