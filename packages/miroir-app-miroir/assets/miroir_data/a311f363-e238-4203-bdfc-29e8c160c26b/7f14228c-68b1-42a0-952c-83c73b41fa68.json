                "package": "miroir-example-library",
                "selfApplication": "5af03c98-fe5e-490b-b08f-e1230971c57f",
                "deployment": "f714bb2f-a12d-4e71-a03b-74dcedea6eb4",
                "store": "filesystem",
                "mode": "live",
                "assetPrefix": "lib"
              }
            }
          },
          "dev"
        ],
        "expectedValue": {
          "status": "ok",
          "deployments": [
            {
              "applicationKey": "library",
              "package": "miroir-example-library",
              "deployment": "f714bb2f-a12d-4e71-a03b-74dcedea6eb4",
              "selfApplication": "5af03c98-fe5e-490b-b08f-e1230971c57f",
              "configuration": {
                "admin": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-example-library/assets"
                },
                "model": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-example-library/assets/lib_model"
                },
                "data": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-example-library/assets/lib_data"
                }
              }
            }
          ]
        }
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "a copy section lives in the environment state directory",
        "functionRef": {
          "module": "miroir-core/1_core/environment/Environment",
          "export": "deriveEnvironmentDeployments"
        },
        "arguments": [
          {
            "applications": {
              "admin": {
                "package": "miroir-app-admin",
