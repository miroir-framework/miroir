                },
                "model": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-app-miroir/assets/miroir_model"
                },
                "data": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-app-miroir/assets/miroir_data"
