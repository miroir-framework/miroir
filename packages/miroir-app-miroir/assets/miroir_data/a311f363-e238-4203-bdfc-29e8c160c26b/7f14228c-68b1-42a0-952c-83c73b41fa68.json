              "deployment": "18db21bf-f8d3-4f6a-8296-84b69f6dc48b",
              "selfApplication": "55af124e-8c05-4bae-a3ef-0933d41daa92",
              "configuration": {
                "admin": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-app-admin/assets"
                },
                "model": {
                  "emulatedServerType": "filesystem",
                  "directory": "packages/miroir-app-admin/assets/admin_model"
                },
                "data": {
                  "emulatedServerType": "filesystem",
                  "directory": ".miroir/dev/admin/data"
                }
              }
            }
          ]
        }
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "a copy application lives entirely in the state directory of its environment",
