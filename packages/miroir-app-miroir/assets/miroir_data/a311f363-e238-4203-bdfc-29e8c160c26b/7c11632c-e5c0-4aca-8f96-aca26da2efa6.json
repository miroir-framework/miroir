  "definition": {
    "miroirTestType": "miroirTestSuite",
    "miroirTestLabel": "fn.entityPrimaryKey",
    "miroirTests": [
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "returns instance.parentUuid when present",
        "functionRef": {
          "module": "miroir-core/1_core/EntityPrimaryKey",
          "export": "resolveInstanceParentUuid"
        },
        "arguments": [
          {
            "uuid": "00000000-0000-4000-8000-000000000001",
            "parentUuid": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
            "parentName": "SomeEntity"
          },
          "11111111-2222-4333-8444-555555555555"
        ],
        "expectedValue": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "falls back to payloadParentUuid when instance.parentUuid is absent",
        "functionRef": {
          "module": "miroir-core/1_core/EntityPrimaryKey",
          "export": "resolveInstanceParentUuid"
        },
        "arguments": [
          {
            "uuid": "00000000-0000-4000-8000-000000000002"
          },
          "11111111-2222-4333-8444-555555555555"
        ],
        "expectedValue": "11111111-2222-4333-8444-555555555555"
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "falls back to payloadParentUuid when instance.parentUuid is undefined",
        "functionRef": {
          "module": "miroir-core/1_core/EntityPrimaryKey",
          "export": "resolveInstanceParentUuid"
        },
        "arguments": [
          {
            "uuid": "00000000-0000-4000-8000-000000000003",
            "parentUuid": {
              "__miroirJsonUndefined": true
            }
          },
          "11111111-2222-4333-8444-555555555555"
        ],
        "expectedValue": "11111111-2222-4333-8444-555555555555"
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "returns Action2Error when both parentUuid sources are absent",
        "functionRef": {
          "module": "miroir-core/1_core/EntityPrimaryKey",
          "export": "resolveInstanceParentUuid"
        },
        "arguments": [
          {
            "uuid": "00000000-0000-4000-8000-000000000004"
          },
          {
            "__miroirJsonUndefined": true
          }
        ],
        "expectedAction2ErrorType": "FailedToResolveParentUuid"
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "returns Action2Error when both sources are empty string",
        "functionRef": {
          "module": "miroir-core/1_core/EntityPrimaryKey",
          "export": "resolveInstanceParentUuid"
        },
        "arguments": [
          {
            "uuid": "00000000-0000-4000-8000-000000000005",
            "parentUuid": ""
          },
          ""
        ],
        "expectedAction2ErrorType": "FailedToResolveParentUuid"
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "prefers instance.parentUuid over payloadParentUuid",
        "functionRef": {
          "module": "miroir-core/1_core/EntityPrimaryKey",
          "export": "resolveInstanceParentUuid"
        },
        "arguments": [
          {
            "uuid": "00000000-0000-4000-8000-000000000006",
            "parentUuid": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
          },
