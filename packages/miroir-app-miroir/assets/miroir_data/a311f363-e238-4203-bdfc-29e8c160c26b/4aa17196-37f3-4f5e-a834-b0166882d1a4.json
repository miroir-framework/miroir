{
  "uuid": "4aa17196-37f3-4f5e-a834-b0166882d1a4",
  "parentName": "MiroirTest",
  "parentUuid": "a311f363-e238-4203-bdfc-29e8c160c26b",
  "name": "fn.transformer.treeEdit",
  "selfApplication": "360fcf1f-f0d4-4f8a-9262-07886e70fa15",
  "branch": "ad1ddc4e-556e-4598-9cff-706a2bde0be7",
  "description": "Structural edits of a transformer tree: slots of a transformer type, wrap, pipe into, unwrap, remove, and the attributes kept on a type change.",
  "tags": [
    "unit",
    "transformer"
  ],
  "issue": "415",
  "definition": {
    "miroirTestType": "miroirTestSuite",
    "miroirTestLabel": "fn.transformer.treeEdit",
    "miroirTests": [
      {
        "miroirTestType": "miroirTestSuite",
        "miroirTestLabel": "transformerSlots",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "mapList: the element transformer, then applyTo",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "transformerSlots"
            },
            "arguments": [
              "mapList"
            ],
            "expectedValue": [
              {
                "name": "elementTransformer",
                "template": [
                  "elementTransformer"
                ],
                "optional": false,
                "isApplyTo": false
              },
              {
                "name": "applyTo",
                "template": [
                  "applyTo"
                ],
                "optional": true,
                "isApplyTo": true
              }
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "ifThenElse: if, then and else",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "transformerSlots"
            },
            "arguments": [
              "ifThenElse"
            ],
            "expectedValue": [
              {
                "name": "if",
                "template": [
                  "if"
                ],
                "optional": false,
                "isApplyTo": false
              },
              {
                "name": "then",
                "template": [
                  "then"
                ],
                "optional": true,
                "isApplyTo": false
              },
              {
                "name": "else",
                "template": [
                  "else"
                ],
                "optional": true,
                "isApplyTo": false
              }
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "case: slots inside an array of objects",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "transformerSlots"
            },
            "arguments": [
              "case"
            ],
            "expectedValue": [
              {
                "name": "discriminator",
                "template": [
                  "discriminator"
                ],
                "optional": false,
                "isApplyTo": false
              },
              {
                "name": "whens[].when",
                "template": [
                  "whens",
                  "[]",
                  "when"
                ],
                "optional": false,
                "isApplyTo": false
              },
              {
                "name": "whens[].then",
                "template": [
                  "whens",
                  "[]",
                  "then"
                ],
                "optional": false,
                "isApplyTo": false
              },
              {
                "name": "else",
                "template": [
                  "else"
                ],
                "optional": true,
                "isApplyTo": false
              }
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "+: an array slot",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "transformerSlots"
            },
            "arguments": [
              "+"
            ],
            "expectedValue": [
              {
                "name": "args[]",
                "template": [
                  "args",
                  "[]"
                ],
                "optional": false,
                "isApplyTo": false
              }
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "createObject: a record slot",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "transformerSlots"
            },
            "arguments": [
              "createObject"
            ],
            "expectedValue": [
              {
                "name": "definition{}",
                "template": [
                  "definition",
                  "{}"
                ],
                "optional": false,
                "isApplyTo": false
              }
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "sortList: applyTo only",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "transformerSlots"
            },
            "arguments": [
              "sortList"
            ],
            "expectedValue": [
              {
                "name": "applyTo",
                "template": [
                  "applyTo"
                ],
                "optional": true,
                "isApplyTo": true
              }
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "returnValue: no slot",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "transformerSlots"
            },
            "arguments": [
              "returnValue"
            ],
            "expectedValue": []
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "unknown type: no slot",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "transformerSlots"
            },
            "arguments": [
              "notATransformer"
            ],
            "expectedValue": []
          }
        ]
      },
      {
        "miroirTestType": "miroirTestSuite",
        "miroirTestLabel": "wrapTransformerNode",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "wrap in mapList puts the node in elementTransformer",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "wrapTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "returnValue",
                "mlSchema": {
                  "type": "string"
                },
                "value": "seize value..."
              },
              {
                "transformerType": "mapList",
                "elementTransformer": {
                  "transformerType": "returnValue",
                  "value": "default"
                }
              }
            ],
            "expectedValue": {
              "transformerType": "mapList",
              "elementTransformer": {
                "transformerType": "returnValue",
                "mlSchema": {
                  "type": "string"
                },
                "value": "seize value..."
              }
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "wrap in ifThenElse at the chosen slot",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "wrapTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              },
              {
                "transformerType": "ifThenElse",
                "if": true
              },
              "then"
            ],
            "expectedValue": {
              "transformerType": "ifThenElse",
              "if": true,
              "then": {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              }
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "wrap in + creates a one-item args array",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "wrapTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              },
              {
                "transformerType": "+",
                "args": []
              }
            ],
            "expectedValue": {
              "transformerType": "+",
              "args": [
                {
                  "transformerType": "getFromContext",
                  "referenceName": "defaultInput"
                }
              ]
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "wrap in createObject keys the entry by the node label",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "wrapTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "getFromContext",
                "label": "name",
                "referencePath": [
                  "defaultInput",
                  "name"
                ]
              },
              {
                "transformerType": "createObject",
                "definition": {}
              }
            ],
            "expectedValue": {
              "transformerType": "createObject",
              "definition": {
                "name": {
                  "transformerType": "getFromContext",
                  "label": "name",
                  "referencePath": [
                    "defaultInput",
                    "name"
                  ]
                }
              }
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "wrap in createObject keys an unlabelled node as value",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "wrapTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              },
              {
                "transformerType": "createObject",
                "definition": {
                  "a": 1
                }
              }
            ],
            "expectedValue": {
              "transformerType": "createObject",
              "definition": {
                "value": {
                  "transformerType": "getFromContext",
                  "referenceName": "defaultInput"
                }
              }
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "wrap in case at whens[].when keeps the first when-then item",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "wrapTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              },
              {
                "transformerType": "case",
                "discriminator": "x",
                "whens": [
                  {
                    "when": "a",
                    "then": "b"
                  }
                ]
              },
              "whens[].when"
            ],
            "expectedValue": {
              "transformerType": "case",
              "discriminator": "x",
              "whens": [
                {
                  "when": {
                    "transformerType": "getFromContext",
                    "referenceName": "defaultInput"
                  },
                  "then": "b"
                }
              ]
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "wrap in a type with several slots needs a slot name",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "wrapTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              },
              {
                "transformerType": "ifThenElse",
                "if": true
              }
            ],
            "expectedError": "a slot name is required"
          }
        ]
      },
      {
        "miroirTestType": "miroirTestSuite",
        "miroirTestLabel": "wrapCandidates",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "array of Book: list transformers with a slot and any-input ones",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "wrapCandidates"
            },
            "arguments": [
              {
                "type": "array",
                "payload": "e8ba151b-d68e-4cc3-9a83-3459d309ccf5"
              },
              {
                "transformerTypes": [
                  "mapList",
                  "filterList",
                  "ifThenElse",
                  "sortList",
                  "returnValue",
                  "mustacheStringTemplate",
                  "+"
                ]
              }
            ],
            "expectedValue": [
              "mapList",
              "filterList",
              "ifThenElse",
              "+"
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "string: no list transformer",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "wrapCandidates"
            },
            "arguments": [
              "string",
              {
                "transformerTypes": [
                  "mapList",
                  "filterList",
                  "ifThenElse",
                  "sortList",
                  "returnValue",
                  "mustacheStringTemplate",
                  "+"
                ]
              }
            ],
            "expectedValue": [
              "ifThenElse",
              "+"
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "any: every type with a non-applyTo slot",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "wrapCandidates"
            },
            "arguments": [
              "any",
              {
                "transformerTypes": [
                  "mapList",
                  "filterList",
                  "ifThenElse",
                  "sortList",
                  "returnValue",
                  "mustacheStringTemplate",
                  "+"
                ]
              }
            ],
            "expectedValue": [
              "mapList",
              "filterList",
              "ifThenElse",
              "+"
            ]
          }
        ]
      },
      {
        "miroirTestType": "miroirTestSuite",
        "miroirTestLabel": "pipeTransformerNode",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "pipe into sortList puts the node in applyTo",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "pipeTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              },
              {
                "transformerType": "sortList",
                "interpolation": "runtime",
                "attributeName": "name"
              }
            ],
            "expectedValue": {
              "transformerType": "sortList",
              "interpolation": "runtime",
              "attributeName": "name",
              "applyTo": {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              }
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "pipe into stringOp keeps the new node's attributes",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "pipeTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "getObjectValues",
                "interpolation": "runtime"
              },
              {
                "transformerType": "stringOp",
                "op": "toUpperCase"
              }
            ],
            "expectedValue": {
              "transformerType": "stringOp",
              "op": "toUpperCase",
              "applyTo": {
                "transformerType": "getObjectValues",
                "interpolation": "runtime"
              }
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "pipe replaces an applyTo the new node already has",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "pipeTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              },
              {
                "transformerType": "listLength",
                "applyTo": {
                  "transformerType": "returnValue",
                  "value": []
                }
              }
            ],
            "expectedValue": {
              "transformerType": "listLength",
              "applyTo": {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              }
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "pipe into a type without applyTo fails",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "pipeTransformerNode"
            },
            "arguments": [
              {
                "transformerType": "getFromContext",
                "referenceName": "defaultInput"
              },
              {
                "transformerType": "+",
                "args": []
              }
            ],
            "expectedError": "+ has no applyTo"
          }
        ]
      },
      {
        "miroirTestType": "miroirTestSuite",
        "miroirTestLabel": "pipeCandidates",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "array output: list transformers, not getObjectValues",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "pipeCandidates"
            },
            "arguments": [
              {
                "type": "array",
                "payload": "any"
              },
              {
                "transformerTypes": [
                  "sortList",
                  "listLength",
                  "mapList",
                  "stringOp",
                  "getObjectValues",
                  "+",
                  "returnValue"
                ]
              }
            ],
            "expectedValue": [
              "sortList",
              "listLength",
              "mapList",
              "stringOp"
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "string output: no list transformer",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "pipeCandidates"
            },
            "arguments": [
              "string",
              {
                "transformerTypes": [
                  "sortList",
                  "listLength",
                  "mapList",
                  "stringOp",
                  "getObjectValues",
                  "+",
                  "returnValue"
                ]
              }
            ],
            "expectedValue": [
              "stringOp"
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "any output: every type declaring applyTo",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerTreeEdit",
              "export": "pipeCandidates"
            },
            "arguments": [
              "any",
              {
                "transformerTypes": [
                  "sortList",
                  "listLength",
                  "mapList",
                  "stringOp",
                  "getObjectValues",
                  "+",
                  "returnValue"
                ]
              }
            ],
            "expectedValue": [
              "sortList",
              "listLength",
              "mapList",
              "stringOp",
              "getObjectValues"
            ]
          }
        ]
      }
    ]
  }
}
