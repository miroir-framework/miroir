        "miroirTestLabel": "transformerTypesAcceptingInput",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "entity input hides array-input types",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerInterfaceCheck",
              "export": "transformerTypesAcceptingInput"
            },
            "arguments": [
              "e8ba151b-d68e-4cc3-9a83-3459d309ccf5",
              {
                "transformerTypes": [
                  "aggregate",
                  "mapList",
                  "filterList",
                  "sortList",
                  "listLength",
                  "getObjectValues",
                  "dataflowObject",
                  "getFromContext",
                  "ifThenElse"
                ]
              }
            ],
            "expectedValue": {
              "offered": [
                "getObjectValues",
                "dataflowObject",
                "getFromContext",
                "ifThenElse"
              ],
              "hidden": [
                "aggregate",
                "mapList",
                "filterList",
                "sortList",
                "listLength"
              ]
            }
          },
          {
            "miroirTestType": "functionCallTest",
