      {
        "miroirTestType": "miroirTestSuite",
        "miroirTestLabel": "transformerBlockOutline",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "returnValue: one block, its primitive value in the header",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerBlockModel",
              "export": "transformerBlockOutline"
            },
            "arguments": [
              {
                "transformerType": "returnValue",
                "value": "seize value..."
              }
            ],
            "expectedValue": [
              "returnValue [value] value=\"seize value...\""
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "mapList: the element transformer row, then the applyTo row",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerBlockModel",
              "export": "transformerBlockOutline"
            },
            "arguments": [
              {
                "transformerType": "mapList",
                "interpolation": "runtime",
                "referenceToOuterObject": "book",
                "elementTransformer": {
                  "transformerType": "getFromContext",
                  "interpolation": "runtime",
                  "referencePath": [
                    "book",
                    "name"
                  ]
                },
                "applyTo": {
                  "transformerType": "getFromContext",
                  "interpolation": "runtime",
                  "referenceName": "books"
                }
              }
            ],
            "expectedValue": [
              "mapList [list] {runtime} referenceToOuterObject=\"book\"",
              "  elementTransformer: getFromContext [variable] {runtime} referencePath=[\"book\",\"name\"]",
              "  applyTo: getFromContext [variable] {runtime} referenceName=\"books\""
            ]
          }
        ]
      },
      {
        "miroirTestType": "miroirTestSuite",
        "miroirTestLabel": "slots",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "case: the discriminator, each when and then of the whens list, the else",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerBlockModel",
              "export": "transformerBlockOutline"
            },
            "arguments": [
              {
                "transformerType": "case",
                "interpolation": "runtime",
                "discriminator": {
                  "transformerType": "getFromContext",
                  "interpolation": "runtime",
                  "referenceName": "kind"
                },
                "whens": [
                  {
                    "when": {
                      "transformerType": "returnValue",
                      "value": "a"
                    },
                    "then": {
                      "transformerType": "returnValue",
                      "value": 1
                    }
                  }
                ],
                "else": {
                  "transformerType": "returnValue",
                  "value": 0
                }
              }
            ],
            "expectedValue": [
              "case [control] {runtime}",
              "  discriminator: getFromContext [variable] {runtime} referenceName=\"kind\"",
              "  whens: [list]",
              "    - {object}",
              "      when: returnValue [value] value=\"a\"",
              "      then: returnValue [value] value=1",
              "  else: returnValue [value] value=0"
            ]
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "createObject: the definition record holds a transformer and a literal",
            "functionRef": {
              "module": "miroir-core/2_domain/TransformerBlockModel",
              "export": "transformerBlockOutline"
            },
            "arguments": [
              {
                "transformerType": "createObject",
                "definition": {
                  "name": {
                    "transformerType": "getFromContext",
                    "interpolation": "runtime",
                    "referenceName": "name"
                  },
                  "kind": "book"
                }
              }
            ],
            "expectedValue": [
              "createObject [object]",
              "  definition: {object}",
              "    name: getFromContext [variable] {runtime} referenceName=\"name\"",
              "    kind: \"book\""
            ]
          },
