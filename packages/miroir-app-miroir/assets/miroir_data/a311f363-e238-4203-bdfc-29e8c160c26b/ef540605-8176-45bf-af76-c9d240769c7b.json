{
  "uuid": "ef540605-8176-45bf-af76-c9d240769c7b",
  "parentName": "MiroirTest",
  "parentUuid": "a311f363-e238-4203-bdfc-29e8c160c26b",
  "name": "ui.valueHistory",
  "selfApplication": "360fcf1f-f0d4-4f8a-9262-07886e70fa15",
  "branch": "ad1ddc4e-556e-4598-9cff-706a2bde0be7",
  "description": "Undo and redo of the TransformerEditor's transformer: Undo and Redo start disabled, Undo brings back the value before a form edit and Redo the edit, and an edit after an Undo drops what Redo would have restored.",
  "tags": [
    "ui",
    "editor",
    "transformer"
  ],
  "issue": "499",
  "definition": {
    "miroirTestType": "miroirTestSuite",
    "miroirTestLabel": "ui.valueHistory",
    "miroirTests": [
      {
        "miroirTestType": "reactComponentTestSuite",
        "miroirTestLabel": "TransformerEditor",
        "component": "TransformerEditor",
        "componentProps": {
          "application": "360fcf1f-f0d4-4f8a-9262-07886e70fa15",
          "entityUuid": "16dbfe28-e1d7-4f20-9ba4-c1a9873202ad"
        },
        "miroirTests": [
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "TransformerEditor: Undo and Redo are disabled before any edit",
            "steps": [
              {
                "step": "waitForAttribute",
                "label": "Undo disabled",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "true",
                "timeout": 2000
              },
              {
                "step": "waitForAttribute",
                "label": "Redo disabled",
                "target": {
                  "byTestId": "value-history-redo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "true"
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "TransformerEditor: Undo brings back the value before a form edit, Redo the edit",
            "steps": [
              {
                "step": "change",
                "label": "edit the returned value in the form",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "value": "new value"
              },
              {
                "step": "waitForAttribute",
                "label": "Undo enabled",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "false",
                "timeout": 2000
              },
              {
                "step": "waitForAttribute",
                "label": "Redo still disabled",
                "target": {
                  "byTestId": "value-history-redo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "true"
              },
              {
                "step": "click",
                "label": "undo",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                }
              },
              {
                "step": "expectElement",
                "label": "the value before the edit",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "timeout": 2000
              },
              {
                "step": "expectElement",
                "label": "the edit is gone",
                "target": {
                  "byDisplayValue": "new value"
                },
                "present": false
              },
              {
                "step": "waitForAttribute",
                "label": "nothing more to undo",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "true",
                "timeout": 2000
              },
              {
                "step": "waitForAttribute",
                "label": "Redo enabled",
                "target": {
                  "byTestId": "value-history-redo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "false"
              },
              {
                "step": "click",
                "label": "redo",
                "target": {
                  "byTestId": "value-history-redo:transformer"
                }
              },
              {
                "step": "expectElement",
                "label": "the edit is back",
                "target": {
                  "byDisplayValue": "new value"
                },
                "timeout": 2000
              },
              {
                "step": "waitForAttribute",
                "label": "nothing more to redo",
                "target": {
                  "byTestId": "value-history-redo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "true",
                "timeout": 2000
              },
              {
                "step": "waitForAttribute",
                "label": "Undo enabled again",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "false"
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "TransformerEditor: an edit after an Undo drops what Redo would have restored",
            "steps": [
              {
                "step": "change",
                "label": "first edit",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "value": "first"
              },
              {
                "step": "change",
                "label": "second edit",
                "target": {
                  "byDisplayValue": "first"
                },
                "value": "second"
              },
              {
                "step": "click",
                "label": "undo the second edit",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                }
              },
              {
                "step": "expectElement",
                "label": "the first edit",
                "target": {
                  "byDisplayValue": "first"
                },
                "timeout": 2000
              },
              {
                "step": "change",
                "label": "another edit",
                "target": {
                  "byDisplayValue": "first"
                },
                "value": "third"
              },
              {
                "step": "waitForAttribute",
                "label": "nothing to redo",
                "target": {
                  "byTestId": "value-history-redo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "true",
                "timeout": 2000
              },
              {
                "step": "click",
                "label": "undo the other edit",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                }
              },
              {
                "step": "expectElement",
                "label": "the first edit again",
                "target": {
                  "byDisplayValue": "first"
                },
                "timeout": 2000
              },
              {
                "step": "click",
                "label": "undo the first edit",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                }
              },
              {
                "step": "expectElement",
                "label": "the starting value",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "timeout": 2000
              },
              {
                "step": "waitForAttribute",
                "label": "nothing more to undo",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "true",
                "timeout": 2000
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "TransformerEditor: typing in a field is one step, Ctrl+Z undoes it, Ctrl+Y and Ctrl+Shift+Z redo it",
            "steps": [
              {
                "step": "click",
                "label": "pick the returned value field",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "saveAs": "valueInput"
              },
              {
                "step": "clear",
                "label": "clear the field",
                "target": {
                  "ref": "valueInput"
                }
              },
              {
                "step": "type",
                "label": "type a new value",
                "target": {
                  "ref": "valueInput"
                },
                "text": "typed"
              },
              {
                "step": "expectElement",
                "label": "the typed value",
                "target": {
                  "byDisplayValue": "typed"
                },
                "timeout": 2000
              },
              {
                "step": "keyboard",
                "label": "Ctrl+Z",
                "keys": "{Control>}z{/Control}"
              },
              {
                "step": "expectElement",
                "label": "the value before clearing and typing, in one step",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "timeout": 2000
              },
              {
                "step": "waitForAttribute",
                "label": "nothing more to undo",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "true",
                "timeout": 2000
              },
              {
                "step": "keyboard",
                "label": "Ctrl+Y",
                "keys": "{Control>}y{/Control}"
              },
              {
                "step": "expectElement",
                "label": "the typed value is back",
                "target": {
                  "byDisplayValue": "typed"
                },
                "timeout": 2000
              },
              {
                "step": "keyboard",
                "label": "Ctrl+Z again",
                "keys": "{Control>}z{/Control}"
              },
              {
                "step": "expectElement",
                "label": "the value before typing again",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "timeout": 2000
              },
              {
                "step": "keyboard",
                "label": "Ctrl+Shift+Z",
                "keys": "{Control>}{Shift>}z{/Shift}{/Control}"
              },
              {
                "step": "expectElement",
                "label": "the typed value is back again",
                "target": {
                  "byDisplayValue": "typed"
                },
                "timeout": 2000
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "TransformerEditor: typing again after leaving the field is another step",
            "steps": [
              {
                "step": "click",
                "label": "pick the returned value field",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "saveAs": "valueInput"
              },
              {
                "step": "type",
                "label": "type at the end",
                "target": {
                  "ref": "valueInput"
                },
                "text": " one"
              },
              {
                "step": "keyboard",
                "label": "leave the field",
                "keys": "{Tab}"
              },
              {
                "step": "type",
                "label": "type at the end again",
                "target": {
                  "ref": "valueInput"
                },
                "text": " two"
              },
              {
                "step": "expectElement",
                "label": "both typings",
                "target": {
                  "byDisplayValue": "seize value... one two"
                },
                "timeout": 2000
              },
              {
                "step": "keyboard",
                "label": "Ctrl+Z",
                "keys": "{Control>}z{/Control}"
              },
              {
                "step": "expectElement",
                "label": "the first typing only",
                "target": {
                  "byDisplayValue": "seize value... one"
                },
                "timeout": 2000
              },
              {
                "step": "keyboard",
                "label": "Ctrl+Z again",
                "keys": "{Control>}z{/Control}"
              },
              {
                "step": "expectElement",
                "label": "the starting value",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "timeout": 2000
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "TransformerEditor: typing a character and deleting it adds no step",
            "steps": [
              {
                "step": "click",
                "label": "pick the returned value field",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "saveAs": "valueInput"
              },
              {
                "step": "type",
                "label": "type a character",
                "target": {
                  "ref": "valueInput"
                },
                "text": "x"
              },
              {
                "step": "expectElement",
                "label": "the typed character",
                "target": {
                  "byDisplayValue": "seize value...x"
                },
                "timeout": 2000
              },
              {
                "step": "keyboard",
                "label": "delete it",
                "keys": "{Backspace}"
              },
              {
                "step": "expectElement",
                "label": "the starting value",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "timeout": 2000
              },
              {
                "step": "waitForAttribute",
                "label": "nothing to undo",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                },
                "attribute": "aria-disabled",
                "value": "true",
                "timeout": 2000
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "TransformerEditor: two choices in one select are two steps",
            "steps": [
              {
                "step": "clickObjectButton",
                "label": "add interpolation",
                "field": "transformerEditor_transformer_selector.transformer",
                "action": "addOptionalAttribute",
                "attribute": "interpolation"
              },
              {
                "step": "selectOption",
                "label": "interpolation at runtime",
                "field": "transformerEditor_transformer_selector.transformer.interpolation",
                "option": "runtime"
              },
              {
                "step": "selectOption",
                "label": "interpolation at build",
                "field": "transformerEditor_transformer_selector.transformer.interpolation",
                "option": "build"
              },
              {
                "step": "click",
                "label": "undo",
                "target": {
                  "byTestId": "value-history-undo:transformer"
                }
              },
              {
                "step": "expectElement",
                "label": "back to runtime, not to the value before both choices",
                "target": {
                  "widget": "combobox",
                  "field": "transformerEditor_transformer_selector.transformer.interpolation"
                },
                "value": "runtime",
                "timeout": 2000
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "TransformerEditor: Ctrl+Z in a dialog does not undo the transformer",
            "steps": [
              {
                "step": "change",
                "label": "edit the returned value",
                "target": {
                  "byDisplayValue": "seize value..."
                },
                "value": "edited"
              },
              {
                "step": "click",
                "label": "open the root node actions",
                "target": {
                  "byLabelText": "Transformer node actions transformer"
                }
              },
              {
                "step": "click",
                "label": "Wrap in",
                "target": {
                  "byTestId": "transformer-node-action-wrap"
                }
              },
              {
                "step": "selectOption",
                "label": "choose ifThenElse in the dialog",
                "field": "transformer-node-dialog-type",
                "option": "ifThenElse"
              },
              {
                "step": "keyboard",
                "label": "Ctrl+Z in the dialog",
                "keys": "{Control>}z{/Control}"
              },
              {
                "step": "expectElement",
                "label": "the edit stays",
                "target": {
                  "byDisplayValue": "edited"
                },
                "timeout": 2000
              },
              {
                "step": "click",
                "label": "cancel the wrap",
                "target": {
                  "byTestId": "transformer-node-dialog-cancel"
                }
              },
              {
                "step": "expectElement",
                "label": "the edit is still there",
                "target": {
                  "byDisplayValue": "edited"
                },
                "timeout": 2000
              }
            ]
          }
        ]
      }
    ]
  }
}
