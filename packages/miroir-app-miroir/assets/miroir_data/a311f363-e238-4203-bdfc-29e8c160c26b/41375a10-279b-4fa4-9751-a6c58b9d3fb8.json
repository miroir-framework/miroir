  "description": "Git version control: a repository path named by the deployment section, Entity and instance key it stores, and whether a path belongs to the application's section folders.",
  "tags": [
    "unit"
  ],
  "issue": "679",
  "definition": {
    "miroirTestType": "miroirTestSuite",
    "miroirTestLabel": "fn.gitPathToInstance",
    "miroirTests": [
      {
        "miroirTestType": "miroirTestSuite",
        "miroirTestLabel": "gitPathToInstance",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "an instance file of the data section",
            "functionRef": {
              "module": "miroir-core/2_domain/GitPathNaming",
              "export": "gitPathToInstance"
            },
            "arguments": [
              "library/data/e8ba151b-d68e-4cc3-9a83-3459d309ccf5/03ffcae1-b83f-4970-b3d9-04780d3d0780.json",
              {
                "model": "library/model",
                "data": "library/data",
                "modelVersion": "library/modelVersion"
              }
            ],
            "expectedValue": {
              "section": "data",
              "entityUuid": "e8ba151b-d68e-4cc3-9a83-3459d309ccf5",
              "instanceKey": "03ffcae1-b83f-4970-b3d9-04780d3d0780"
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "an instance file of the model section",
            "functionRef": {
              "module": "miroir-core/2_domain/GitPathNaming",
              "export": "gitPathToInstance"
            },
            "arguments": [
              "library/model/16dbfe28-e1d7-4f20-9ba4-c1a9873202ad/e8ba151b-d68e-4cc3-9a83-3459d309ccf5.json",
              {
                "model": "library/model",
                "data": "library/data",
                "modelVersion": "library/modelVersion"
              }
            ],
            "expectedValue": {
              "section": "model",
              "entityUuid": "16dbfe28-e1d7-4f20-9ba4-c1a9873202ad",
              "instanceKey": "e8ba151b-d68e-4cc3-9a83-3459d309ccf5"
            }
          },
          {
            "miroirTestType": "functionCallTest",
