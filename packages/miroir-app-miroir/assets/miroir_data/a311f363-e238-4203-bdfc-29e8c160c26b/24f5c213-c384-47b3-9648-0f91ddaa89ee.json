{
  "uuid": "24f5c213-c384-47b3-9648-0f91ddaa89ee",
  "parentName": "MiroirTest",
  "parentUuid": "a311f363-e238-4203-bdfc-29e8c160c26b",
  "selfApplication": "360fcf1f-f0d4-4f8a-9262-07886e70fa15",
  "branch": "ad1ddc4e-556e-4598-9cff-706a2bde0be7",
  "name": "report.pageLoadHistory",
  "description": "Miroir's page load Reports, opened on the devData section of a Library testbed, on fixed measurements of four page loads (production web page twice, development web page, production Electron): the history shows one initial load graph and one first report display graph per (build mode, client) pair, each with its own rows only, and the lists of initial loads and route steps with their build mode and client; the details Report shows one step, its build mode, client, environment and files.",
  "tags": [
    "integ",
    "ui",
    "report"
  ],
  "issue": "583",
  "definition": {
    "miroirTestType": "miroirTestSuite",
    "miroirTestLabel": "report.pageLoadHistory",
    "runTarget": {
      "applicationUuid": "5af03c98-fe5e-490b-b08f-e1230971c57f",
      "applicationName": "Library",
      "deploymentUuid": "f714bb2f-a12d-4e71-a03b-74dcedea6eb4"
    },
    "testConfiguration": "a8dd8a49-97de-426c-beb7-c32d0f1beb26",
    "testbedInitApplicationParameters": "libraryTestbedInitParams",
    "miroirTests": [
      {
        "miroirTestType": "reportTestSuite",
        "miroirTestLabel": "PageLoadHistory",
        "report": {
          "application": "5af03c98-fe5e-490b-b08f-e1230971c57f",
          "applicationSection": "devData",
          "reportUuid": "02dd2ead-7b8d-4160-99c9-9f4e9a1c051b"
        },
        "miroirTests": [
          {
            "miroirTestType": "reportTest",
            "miroirTestLabel": "shows each (build mode, client) pair apart, and the initial loads and route steps",
            "steps": [
              {
                "step": "expectElement",
                "label": "the production web page initial load graph: loads A and B",
                "target": {
                  "byTestId": "graph-line-initialLoadsProductionWebApp"
                },
                "attribute": {
                  "name": "data-point-count",
                  "value": "2"
                },
                "timeout": 15000
              },
              {
                "step": "expectElement",
                "label": "the production Electron initial load graph: load D",
                "target": {
                  "byTestId": "graph-line-initialLoadsProductionElectron"
                },
                "attribute": {
                  "name": "data-point-count",
                  "value": "1"
                },
                "timeout": 5000
              },
              {
                "step": "expectElement",
                "label": "the development web page initial load graph: load C",
                "target": {
                  "byTestId": "graph-line-initialLoadsDevelopmentWebApp"
                },
                "attribute": {
                  "name": "data-point-count",
                  "value": "1"
                },
                "timeout": 5000
              },
              {
                "step": "expectElement",
                "label": "the production web page first report display graph: load A",
                "target": {
                  "byTestId": "graph-line-reportRoutesProductionWebApp"
                },
                "attribute": {
                  "name": "data-point-count",
                  "value": "1"
                },
                "timeout": 5000
              },
              {
                "step": "expectElement",
                "label": "the development web page first report display graph: load C",
                "target": {
                  "byTestId": "graph-line-reportRoutesDevelopmentWebApp"
                },
                "attribute": {
                  "name": "data-point-count",
                  "value": "1"
                },
                "timeout": 5000
              },
              {
                "step": "expectElement",
                "label": "no development Electron initial load graph: no row",
                "target": {
                  "byTestId": "graph-line-initialLoadsDevelopmentElectron"
                },
                "present": false
              },
              {
                "step": "expectElement",
                "label": "no production Electron first report display graph: no row",
                "target": {
                  "byTestId": "graph-line-reportRoutesProductionElectron"
                },
                "present": false
              },
              {
                "step": "expectElement",
                "label": "no development Electron first report display graph: no row",
                "target": {
                  "byTestId": "graph-line-reportRoutesDevelopmentElectron"
                },
                "present": false
              },
              {
                "step": "expectElement",
                "label": "the initial load list",
                "target": {
                  "byText": "Initial page loads"
                },
                "timeout": 5000
              },
              {
                "step": "expectElement",
                "label": "the route list",
                "target": {
                  "byText": "First display of each page kind"
                },
                "timeout": 5000
              },
              {
                "step": "expectElement",
                "label": "the model page step, in the route list only",
                "target": {
                  "byText": "route:model"
                },
                "timeout": 5000,
                "count": 1
              },
              {
                "step": "expectElement",
                "label": "the initial load steps of loads A, B, C and D, in the initial load list only",
                "target": {
                  "byText": "initialLoad"
                },
                "timeout": 5000,
                "count": 4
              },
              {
                "step": "expectElement",
                "label": "the client column: load D's initial load is an Electron row",
                "target": {
                  "byText": "electron"
                },
                "timeout": 5000,
                "count": 1
              },
              {
                "step": "expectElement",
                "label": "the build mode column: load C's initial load and first report display are development rows",
                "target": {
                  "byText": "development"
                },
                "timeout": 5000,
                "count": 2
              }
            ]
          }
        ]
      },
      {
        "miroirTestType": "reportTestSuite",
        "miroirTestLabel": "PageLoadMeasurementDetails",
        "report": {
          "application": "5af03c98-fe5e-490b-b08f-e1230971c57f",
          "applicationSection": "devData",
          "reportUuid": "193c3dea-792d-471a-88a0-546e4b5e81cf",
          "instanceUuid": "691c8330-7349-467b-9d28-6e06b7e707ec"
        },
        "miroirTests": [
          {
            "miroirTestType": "reportTest",
            "miroirTestLabel": "shows the step, its build mode, client, environment and files",
            "steps": [
              {
                "step": "expectElement",
                "label": "the step",
                "target": {
                  "byDisplayValue": "route:report"
                },
                "timeout": 15000
              },
              {
                "step": "expectElement",
                "label": "a file fetched during the step",
                "target": {
                  "byDisplayValue": "/assets/ReportDisplay-seed.js"
                },
                "timeout": 5000
              },
              {
                "step": "expectElement",
                "label": "the build mode",
                "target": {
                  "byDisplayValue": "production"
                },
                "timeout": 5000
              },
              {
                "step": "expectElement",
                "label": "the client",
                "target": {
                  "byDisplayValue": "webApp"
                },
                "timeout": 5000
              },
              {
                "step": "expectElement",
                "label": "the environment",
                "target": {
                  "byDisplayValue": "dev"
                },
                "timeout": 5000
              }
            ]
          }
        ]
      }
    ]
  }
}
