                "action": {
                  "actionType": "compositeRunBoxedQueryAction",
                  "endpoint": "1e2ef8e6-7fdf-4e3f-b291-2e6e599fb2b5",
                  "actionLabel": "readStoredBook",
                  "nameGivenToResult": "storedBook",
                  "payload": {
                    "actionType": "runBoxedQueryAction",
                    "endpoint": "9e404b3c-368c-40cb-be8b-e3c28550c25e",
                    "payload": {
                      "application": {
                        "transformerType": "getFromParameters",
                        "interpolation": "build",
                        "referenceName": "testApplicationUuid"
                      },
                      "applicationSection": "data",
                      "queryExecutionStrategy": "storage",
                      "query": {
                        "queryType": "boxedQueryWithExtractorCombinerTransformer",
                        "application": {
                          "transformerType": "getFromParameters",
                          "interpolation": "build",
                          "referenceName": "testApplicationUuid"
                        },
                        "pageParams": {
                          "currentDeploymentUuid": {
                            "transformerType": "getFromParameters",
                            "interpolation": "build",
                            "referenceName": "testApplicationDeploymentUuid"
                          }
                        },
                        "extractors": {
                          "book": {
                            "extractorOrCombinerType": "extractorByPrimaryKey",
                            "applicationSection": "data",
                            "parentName": "Book",
                            "parentUuid": "e8ba151b-d68e-4cc3-9a83-3459d309ccf5",
                            "instanceUuid": "e20e276b-619d-4e16-8816-b7ec37b53439"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "step": "expectActionResult",
                "label": "the stored name is the displayed one",
                "assertion": {
                  "actionType": "compositeRunTestAssertion",
                  "actionLabel": "storedBookName",
                  "nameGivenToResult": "storedBookName",
                  "testAssertion": {
                    "testType": "testAssertion",
                    "testLabel": "storedBookName",
                    "definition": {
                      "resultTransformer": {
                        "transformerType": "createObject",
