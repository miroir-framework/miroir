        "miroirTests": [
          {
            "miroirTestType": "reportTest",
            "miroirTestLabel": "only transformer fields have the view switch",
            "steps": [
              {
                "step": "expectElement",
                "label": "the Query's name, read from the testbed store",
                "target": {
                  "byDisplayValue": "BookCountByPublisher"
                },
                "timeout": 15000
              },
              {
                "step": "expectElement",
                "label": "the runtime transformer has the view switch",
                "target": {
                  "byTestId": "block-view-switch:definition.runtimeTransformers.00_BookCountByPublisher"
                },
                "timeout": 5000
              },
              {
                "step": "expectElement",
                "label": "the name has none",
                "target": {
                  "byTestId": "block-view-switch:name"
                },
                "present": false
              },
              {
                "step": "expectElement",
                "label": "the Query definition has none",
                "target": {
                  "byTestId": "block-view-switch:definition"
                },
                "present": false
              }
            ]
          },
          {
            "miroirTestType": "reportTest",
            "miroirTestLabel": "a runtime transformer edited as blocks is saved",
            "steps": [
              {
                "step": "expectElement",
                "label": "the Query's name, read from the testbed store",
                "target": {
                  "byDisplayValue": "BookCountByPublisher"
                },
                "timeout": 15000
              },
              {
                "step": "expectElement",
                "label": "the runtime transformer has the view switch",
                "target": {
                  "byTestId": "block-view-switch:definition.runtimeTransformers.00_BookCountByPublisher"
                },
                "timeout": 5000
              },
              {
                "step": "click",
                "label": "show the runtime transformer as blocks",
                "target": {
                  "byTestId": "block-view-mode:definition.runtimeTransformers.00_BookCountByPublisher:blocks"
                }
              },
              {
                "step": "expectElement",
                "label": "its root block",
                "target": {
                  "byTestId": "block:definition.runtimeTransformers.00_BookCountByPublisher"
                },
                "timeout": 10000,
                "attribute": {
                  "name": "data-transformer-type",
                  "value": "aggregate"
                }
              },
              {
                "step": "click",
                "label": "open the groupBy field",
                "target": {
                  "byTestId": "block-field:definition.runtimeTransformers.00_BookCountByPublisher.groupBy"
                }
              },
              {
                "step": "clear",
                "label": "clear it",
                "target": {
                  "byTestId": "block-field-input:definition.runtimeTransformers.00_BookCountByPublisher.groupBy"
                }
              },
              {
                "step": "type",
                "label": "type the new groupBy (user-event types [[ as [)",
                "target": {
                  "byTestId": "block-field-input:definition.runtimeTransformers.00_BookCountByPublisher.groupBy"
                },
                "text": "[[\"publisherName\",\"bookName\"]{Enter}"
              },
              {
                "step": "expectElement",
                "label": "the block shows bookName",
                "target": {
                  "byTestId": "block-field:definition.runtimeTransformers.00_BookCountByPublisher.groupBy"
                },
                "timeout": 5000,
                "containsHtml": "bookName"
              },
              {
                "step": "click",
                "label": "submit the Query",
                "target": {
                  "byTestId": "typed-value-object-editor-submit"
                }
              },
              {
                "step": "compositeAction",
                "label": "commit the Library model",
                "action": {
                  "actionType": "commit",
                  "actionLabel": "commitLibraryModel",
                  "endpoint": "7947ae40-eb34-4149-887b-15a9021e714e",
                  "payload": {
                    "application": {
                      "transformerType": "getFromParameters",
                      "interpolation": "build",
                      "referenceName": "testApplicationUuid"
                    }
                  }
                }
              },
              {
                "step": "compositeAction",
                "label": "read the Query from the store",
                "action": {
                  "actionType": "compositeRunBoxedQueryAction",
                  "endpoint": "1e2ef8e6-7fdf-4e3f-b291-2e6e599fb2b5",
                  "actionLabel": "readStoredQuery",
                  "nameGivenToResult": "storedQuery",
                  "payload": {
                    "actionType": "runBoxedQueryAction",
                    "endpoint": "9e404b3c-368c-40cb-be8b-e3c28550c25e",
                    "payload": {
                      "application": {
                        "transformerType": "getFromParameters",
                        "interpolation": "build",
                        "referenceName": "testApplicationUuid"
                      },
                      "applicationSection": "model",
                      "queryExecutionStrategy": "storage",
                      "query": {
                        "queryType": "boxedQueryWithExtractorCombinerTransformer",
                        "application": {
                          "transformerType": "getFromParameters",
                          "interpolation": "build",
                          "referenceName": "testApplicationUuid"
                        },
                        "pageParams": {
                          "currentDeploymentUuid": {
                            "transformerType": "getFromParameters",
                            "interpolation": "build",
                            "referenceName": "testApplicationDeploymentUuid"
                          }
                        },
                        "extractors": {
                          "query": {
                            "extractorOrCombinerType": "extractorByPrimaryKey",
                            "applicationSection": "model",
                            "parentName": "Query",
                            "parentUuid": "e4320b9e-ab45-4abe-85d8-359604b3c62f",
                            "instanceUuid": "6176dcdf-39a6-4805-8dc5-3c2366a31a11"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "step": "expectActionResult",
                "label": "the store holds the edit",
                "assertion": {
                  "actionType": "compositeRunTestAssertion",
                  "actionLabel": "storedGroupBy",
                  "nameGivenToResult": "storedGroupBy",
                  "testAssertion": {
                    "testType": "testAssertion",
                    "testLabel": "storedGroupBy",
                    "definition": {
                      "resultTransformer": {
                        "transformerType": "getFromContext",
                        "interpolation": "runtime",
                        "referencePath": [
                          "storedQuery",
                          "query",
                          "definition",
                          "runtimeTransformers",
                          "00_BookCountByPublisher",
                          "groupBy"
                        ]
                      },
                      "expectedValue": [
                        "publisherName",
                        "bookName"
                      ]
                    }
                  }
                }
              }
            ]
          },
          {
            "miroirTestType": "reportTest",
            "miroirTestLabel": "undo and redo at the editor root",
            "steps": [
              {
                "step": "expectElement",
                "label": "the Query's name, read from the testbed store",
                "target": {
                  "byDisplayValue": "BookCountByPublisher"
                },
                "timeout": 15000
              },
              {
                "step": "expectElement",
                "label": "the runtime transformer has the view switch",
                "target": {
                  "byTestId": "block-view-switch:definition.runtimeTransformers.00_BookCountByPublisher"
                },
                "timeout": 5000
              },
              {
                "step": "click",
                "label": "show the runtime transformer as blocks",
                "target": {
                  "byTestId": "block-view-mode:definition.runtimeTransformers.00_BookCountByPublisher:blocks"
                }
              },
              {
                "step": "expectElement",
                "label": "its root block",
                "target": {
                  "byTestId": "block:definition.runtimeTransformers.00_BookCountByPublisher"
                },
                "timeout": 10000,
                "attribute": {
                  "name": "data-transformer-type",
                  "value": "aggregate"
                }
              },
              {
                "step": "click",
                "label": "open the groupBy field",
                "target": {
                  "byTestId": "block-field:definition.runtimeTransformers.00_BookCountByPublisher.groupBy"
                }
              },
              {
                "step": "clear",
                "label": "clear it",
                "target": {
                  "byTestId": "block-field-input:definition.runtimeTransformers.00_BookCountByPublisher.groupBy"
                }
              },
              {
                "step": "type",
                "label": "type the new groupBy (user-event types [[ as [)",
                "target": {
                  "byTestId": "block-field-input:definition.runtimeTransformers.00_BookCountByPublisher.groupBy"
                },
                "text": "[[\"publisherName\",\"bookName\"]{Enter}"
              },
              {
                "step": "expectElement",
                "label": "the block shows bookName",
                "target": {
                  "byTestId": "block-field:definition.runtimeTransformers.00_BookCountByPublisher.groupBy"
                },
                "timeout": 5000,
                "containsHtml": "bookName"
              },
              {
                "step": "click",
                "label": "Undo",
                "target": {
                  "byTestId": "value-history-undo:"
                }
              },
              {
                "step": "expectElement",
                "label": "the block shows publisherUuid again",
                "target": {
                  "byTestId": "block-field:definition.runtimeTransformers.00_BookCountByPublisher.groupBy"
                },
                "timeout": 5000,
                "containsHtml": "publisherUuid"
              },
              {
                "step": "click",
                "label": "Redo",
                "target": {
                  "byTestId": "value-history-redo:"
                }
              },
              {
                "step": "expectElement",
                "label": "the block shows bookName again",
                "target": {
                  "byTestId": "block-field:definition.runtimeTransformers.00_BookCountByPublisher.groupBy"
                },
                "timeout": 5000,
                "containsHtml": "bookName"
              }
            ]
          }
        ]
      }
    ]
  }
