{
  "name": "@miroir-framework/server",
  "version": "0.5.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Miroir's HTTP surface (REST, authentication, capabilities, MCP, static assets, client folder) as an Express application built from a running domain controller",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./startup": {
      "types": "./dist/startup.d.ts",
      "import": "./dist/startup.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "test": "cross-env NODE_ENV=test vitest run",
    "testByFile": "cross-env NODE_ENV=test vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-server-library"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@miroir-framework/core": "*",
    "@miroir-framework/mcp": "*",
    "@reduxjs/toolkit": "2.13.0",
    "@teroneko/redux-saga-promise": "4.0.0",
    "body-parser": "2.4.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "immer": "11.1.21",
    "redux-saga": "1.5.1",
    "typed-redux-saga": "1.5.0"
  },
  "devDependencies": {
    "@types/body-parser": "1.19.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "cross-env": "10.1.0",
    "loglevelnext": "6.0.0",
    "miroir-app-admin": "*",
    "miroir-app-miroir": "*",
    "@miroir-framework/env": "*",
    "miroir-example-library": "*",
    "miroir-localcache-redux": "*",
    "@miroir-framework/store-filesystem": "*",
    "tsup": "9.0.0",
    "vitest": "5.0.5"
  }
}
