{
  "name": "miroir-server-library",
  "version": "0.5.0-rc.1",
  "description": "Miroir's HTTP surface (REST, authentication, capabilities, MCP, static assets, client folder) as an Express application built from a running domain controller",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "test": "cross-env NODE_ENV=test vitest run",
    "testByFile": "cross-env NODE_ENV=test vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "dependencies": {
    "body-parser": "2.4.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "miroir-core": "*",
    "miroir-mcp": "*"
  },
  "devDependencies": {
    "@types/body-parser": "1.19.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "cross-env": "10.1.0",
    "loglevelnext": "6.0.0",
    "miroir-app-admin": "*",
    "miroir-app-miroir": "*",
    "miroir-env": "*",
    "miroir-example-library": "*",
    "miroir-localcache-redux": "*",
    "miroir-store-filesystem": "*",
    "tsup": "9.0.0",
    "vitest": "5.0.5"
  }
}
