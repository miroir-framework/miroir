    "miroirTests": [
      {
        "miroirTestType": "miroirTestSuite",
        "miroirTestLabel": "staticOutput",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "currentDate returns string schema",
            "functionRef": {
              "module": "miroir-core/2_domain/Transformer_ResultSchema",
              "export": "resolveTransformerResultSchema"
            },
            "arguments": [
              {
                "transformerType": "currentDate",
                "interpolation": "runtime"
              },
              {}
            ],
            "expectedValue": {
              "type": "string"
            }
          },
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "boolExpr returns boolean schema regardless of operand transformers",
            "functionRef": {
              "module": "miroir-core/2_domain/Transformer_ResultSchema",
              "export": "resolveTransformerResultSchema"
            },
            "arguments": [
              {
                "transformerType": "boolExpr",
                "interpolation": "runtime",
                "operator": "==",
                "left": {
                  "transformerType": "returnValue",
                  "interpolation": "runtime",
                  "value": 1
                },
                "right": {
                  "transformerType": "returnValue",
                  "interpolation": "runtime",
                  "value": 2
                }
              },
              {}
            ],
            "expectedValue": {
              "type": "boolean"
            }
          }
        ]
      },
      {
        "miroirTestType": "miroirTestSuite",
        "miroirTestLabel": "errors",
        "miroirTests": [
          {
            "miroirTestType": "functionCallTest",
            "miroirTestLabel": "throws for unknown transformerType",
            "functionRef": {
              "module": "miroir-core/2_domain/Transformer_ResultSchema",
              "export": "resolveTransformerResultSchema"
            },
            "arguments": [
              {
                "transformerType": "nonExistentTransformer",
                "interpolation": "runtime"
              },
              {}
            ],
            "expectedError": "unknown transformerType \"nonExistentTransformer\""
          }
        ]
      }
    ]
  }
