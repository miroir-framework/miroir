  "definition": {
    "miroirTestType": "miroirTestSuite",
    "miroirTestLabel": "getAttributeTypesFromMlSchema",
    "miroirTests": [
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "should throw an error when mlElement has no type",
        "functionRef": {
          "module": "miroir-store-postgres/1_core/mlSchema",
          "export": "getAttributeTypesFromMlSchema"
        },
        "arguments": [
          {
            "definition": {}
          }
        ],
        "expectedError": "MlSchema has no type"
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "should throw an error when mlElement type is not object",
        "functionRef": {
          "module": "miroir-store-postgres/1_core/mlSchema",
          "export": "getAttributeTypesFromMlSchema"
        },
        "arguments": [
          {
            "type": "string",
            "definition": {}
          }
        ],
        "expectedError": "MlSchema type is not object"
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "should throw an error for unsupported attribute type",
        "functionRef": {
          "module": "miroir-store-postgres/1_core/mlSchema",
          "export": "getAttributeTypesFromMlSchema"
        },
        "arguments": [
          {
            "type": "object",
            "definition": {
              "field": {
                "type": "unsupported"
              }
            }
          }
        ],
        "expectedError": "ML type unsupported not supported"
      },
      {
        "miroirTestType": "functionCallTest",
        "miroirTestLabel": "should return attribute types for valid mlElement",
        "functionRef": {
          "module": "miroir-store-postgres/1_core/mlSchema",
          "export": "getAttributeTypesFromMlSchema"
        },
        "arguments": [
          {
            "type": "object",
            "definition": {
              "age": {
                "type": "number"
              },
              "name": {
                "type": "string"
              },
              "isActive": {
                "type": "boolean"
              }
            }
          }
        ],
        "expectedValue": {
          "age": "double precision",
          "name": "text",
          "isActive": "boolean"
        }
      }
    ]
  }
