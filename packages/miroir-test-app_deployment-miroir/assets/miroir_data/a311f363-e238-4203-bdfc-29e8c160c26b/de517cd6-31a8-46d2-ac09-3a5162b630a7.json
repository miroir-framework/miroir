            "steps": [
              {
                "step": "expectRenderedValues",
                "label": "initial form state",
                "filter": [],
                "expectedValue": {
                  "testField": 42
                }
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "JzodUnionEditor: union between simple type and object for value object renders input with proper value",
            "componentProps": {
              "rawJzodSchema": {
                "type": "union",
                "definition": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "object",
