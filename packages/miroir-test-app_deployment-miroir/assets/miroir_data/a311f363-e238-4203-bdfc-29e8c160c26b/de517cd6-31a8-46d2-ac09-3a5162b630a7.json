                  "b": 42
                }
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "JzodUnionEditor: union between 2 object types with a discriminator for value object renders input following the proper value type",
            "componentProps": {
              "rawJzodSchema": {
                "type": "union",
                "discriminator": "testObjectType",
                "definition": [
                  {
                    "type": "object",
                    "definition": {
                      "testObjectType": {
                        "type": "literal",
                        "definition": "type1"
                      },
                      "type1Attribute": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "definition": {
                      "testObjectType": {
                        "type": "literal",
                        "definition": "type2"
                      },
                      "type2Attribute": {
                        "type": "number"
                      }
                    }
                  }
                ]
              },
              "initialFormState": {
                "testObjectType": "type1",
                "type1Attribute": "test string"
              }
            },
            "steps": [
              {
                "step": "expectRenderedValues",
                "label": "initial form state",
                "field": "testField",
                "expectedValue": {
                  "type1Attribute": "test string",
                  "testObjectType": "type1"
                }
              },
              {
                "step": "expectElement",
                "label": "discriminator select",
                "target": {
                  "byDisplayValue": "type1"
                },
                "value": "type1"
              },
              {
                "step": "expectElement",
                "label": "selected value",
                "target": {
                  "widget": "selectState",
                  "field": "testField.testObjectType"
                },
                "attribute": {
                  "name": "data-test-selected-value",
                  "value": "type1"
                }
              },
              {
                "step": "expectElement",
                "label": "closed",
                "target": {
                  "widget": "selectState",
                  "field": "testField.testObjectType"
                },
                "attribute": {
                  "name": "data-test-is-open",
                  "value": "false"
                }
              },
              {
                "step": "selectOption",
                "label": "select type2",
                "field": "testField.testObjectType",
                "option": "type2"
              },
              {
                "step": "expectElement",
                "label": "type2 fields shown",
                "target": {
                  "byText": "type2Attribute",
                  "index": 0
                },
                "timeout": 5000
              },
              {
                "step": "expectRenderedValues",
                "label": "after change to type2",
                "field": "testField",
                "expectedValue": {
                  "testObjectType": "type2",
                  "type2Attribute": 0
                }
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
