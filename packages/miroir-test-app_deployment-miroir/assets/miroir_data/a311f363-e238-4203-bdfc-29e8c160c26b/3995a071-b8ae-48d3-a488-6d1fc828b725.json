{
  "uuid": "3995a071-b8ae-48d3-a488-6d1fc828b725",
  "parentName": "MiroirTest",
  "parentUuid": "a311f363-e238-4203-bdfc-29e8c160c26b",
  "name": "MlLiteralEditor_ComponentTestSuite",
  "selfApplication": "360fcf1f-f0d4-4f8a-9262-07886e70fa15",
  "branch": "ad1ddc4e-556e-4598-9cff-706a2bde0be7",
  "description": "Issues #286, #292: MlLiteralEditor React component tests (MlElementEditor), one MiroirTest instance per editor. Edited by hand.",
  "definition": {
    "miroirTestType": "miroirTestSuite",
    "miroirTestLabel": "MlLiteralEditor_ComponentTestSuite",
    "miroirTests": [
      {
        "miroirTestType": "reactComponentTestSuite",
        "miroirTestLabel": "MlLiteralEditor",
        "component": "MlElementEditor",
        "componentProps": {
          "name": "testField",
          "listKey": "root.testField",
          "rootLessListKey": "testField",
          "rootLessListKeyArray": [
            "testField"
          ],
          "initialFormState": "test-value",
          "rawMlSchema": {
            "type": "literal",
            "definition": "test-value"
          }
        },
        "miroirTests": [
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "MlLiteralEditor: renders Literal input with label when label prop is provided",
            "componentProps": {
              "label": "Test Label"
            },
            "steps": [
              {
                "step": "expectElement",
                "label": "only one label",
                "target": {
                  "byText": {
                    "regex": "Test Label"
                  }
                },
                "count": 1
              },
              {
                "step": "expectElement",
                "label": "textbox",
                "target": {
                  "byRole": "textbox"
                }
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "MlLiteralEditor: renders Literal input without label when label prop is not provided",
            "steps": [
              {
                "step": "expectElement",
                "label": "no label",
                "target": {
                  "byLabelText": {
                    "regex": "Test Label"
                  }
                },
                "present": false
              },
              {
                "step": "expectElement",
                "label": "textbox",
                "target": {
                  "byRole": "textbox"
                }
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "MlLiteralEditor: setting new value",
            "componentProps": {
              "label": "Test Label"
            },
            "steps": [
              {
                "step": "expectElement",
                "label": "initial value",
                "target": {
                  "byDisplayValue": "test-value"
                },
                "saveAs": "input"
              },
              {
                "step": "change",
                "label": "literal input is not editable",
                "target": {
                  "ref": "input"
                },
                "value": "new value"
              },
              {
                "step": "expectElement",
                "label": "value has not changed",
                "target": {
                  "byDisplayValue": {
                    "regex": "test-value"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
