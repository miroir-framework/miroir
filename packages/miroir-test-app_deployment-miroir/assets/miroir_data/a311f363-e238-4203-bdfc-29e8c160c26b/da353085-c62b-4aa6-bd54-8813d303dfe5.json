              "rawJzodSchema": {
                "type": "object",
                "definition": {
                  "a": {
                    "type": "string"
                  },
                  "b": {
                    "type": "number"
                  }
                }
              },
              "initialFormState": {
                "a": "test string",
                "b": 42
              }
            },
            "steps": [
              {
                "step": "expectRenderedValues",
                "label": "after delete button click",
                "field": "testField",
                "expectedValue": {
                  "a": "test string",
                  "b": 42
                }
              }
            ]
          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "JzodObjectEditor: object with bigint attribute renders as json-like input fields with proper value",
