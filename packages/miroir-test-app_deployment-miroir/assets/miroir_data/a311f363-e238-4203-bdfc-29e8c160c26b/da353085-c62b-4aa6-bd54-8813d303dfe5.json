          },
          {
            "miroirTestType": "reactComponentTest",
            "miroirTestLabel": "JzodObjectEditor: object can be updated through displayed input fields",
            "componentProps": {
              "rawJzodSchema": {
                "type": "object",
                "definition": {
                  "a": {
                    "type": "string"
                  },
                  "b": {
                    "type": "number"
                  }
                }
              },
              "initialFormState": {
                "a": "test string",
                "b": 42
              }
            },
            "steps": [
              {
                "step": "expectElement",
                "label": "initial a",
                "target": {
                  "byTestId": "miroirInput",
                  "fieldName": "testField.a"
                },
                "value": "test string",
                "saveAs": "inputA"
              },
              {
                "step": "expectElement",
                "label": "initial b",
                "target": {
                  "byTestId": "miroirInput",
                  "fieldName": "testField.b"
                },
                "value": 42,
                "saveAs": "inputB"
              },
              {
                "step": "change",
                "target": {
                  "ref": "inputA"
                },
                "value": "new string value"
              },
              {
                "step": "change",
                "target": {
                  "ref": "inputB"
                },
                "value": 100
              },
              {
                "step": "expectRenderedValues",
                "label": "after change",
                "field": "testField",
                "expectedValue": {
                  "a": "new string value",
                  "b": 100
                }
              }
            ]
          },
          {
