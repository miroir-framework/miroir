{
  "name": "miroir-store-filesystem",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "The Miroir implementation for accessing filesystem databases.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "dist/index.js",
  "type": "module",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "watch": "lerna watch --scope='miroir-store-filesystem' --include-dependencies -- lerna run build --scope='miroir-store-filesystem'",
    "build-tsup": "tsup",
    "build": "tsup",
    "devBuild": "npm run build",
    "copy-files": "copyfiles -u 1 src/**/*.json src/**/*.css dist/src",
    "test": "cross-env NODE_ENV=test vitest"
  },
  "dependencies": {
    "miroir-core": "*",
    "miroir-app-miroir": "*",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "30.0.0",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "loglevelnext": "6.0.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.15",
    "tsconfig-paths": "4.2.0",
    "vite": "8.3.5",
    "vite-plugin-node": "8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-store-filesystem"
  }
}
