{
  "name": "@miroir-framework/store-indexeddb",
  "private": true,
  "version": "0.5.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "The Miroir implementation for accessing indexedDb databases (on web browser, or file-based on nodejs server).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "dist/index.js",
  "type": "module",
  "scripts": {
    "watch": "lerna watch --scope='@miroir-framework/store-indexeddb' --include-dependencies -- lerna run build --scope='@miroir-framework/store-indexeddb'",
    "build": "tsup",
    "devBuild": "npm run build",
    "copy-files": "copyfiles -u 1 src/**/*.json src/**/*.css dist/src",
    "test": "jest --verbose --silent=false -t"
  },
  "dependencies": {
    "level": "10.0.0",
    "@miroir-framework/core": "*"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "30.0.0",
    "copyfiles": "2.4.1",
    "rimraf": "6.1.3",
    "tsconfig-paths": "4.2.0",
    "tsup": "9.0.0"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-store-indexedDb"
  }
}
