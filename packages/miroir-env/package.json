{
  "name": "@miroir-framework/env",
  "version": "0.5.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Environment definitions for Miroir: which applications are installed, on which stores, for development and tests (#321)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "type": "module",
  "bin": {
    "miroir-env": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-env"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "test": "cross-env NODE_ENV=test vitest run",
    "testByFile": "cross-env NODE_ENV=test vitest run"
  },
  "dependencies": {
    "@miroir-framework/core": "0.5.0-rc.2",
    "mongodb": "7.7.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@miroir-framework/store-filesystem": "*",
    "miroir-localcache-redux": "*",
    "miroir-localcache-zustand": "*",
    "tsup": "9.0.0"
  }
}
