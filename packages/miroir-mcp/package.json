{
  "name": "miroir-mcp",
  "version": "0.5.0-rc.1",
  "description": "Model Context Protocol (MCP) server for Miroir Framework - exposes InstanceEndpoint actions as MCP tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "test": "cross-env NODE_ENV=test vitest run --bail=1",
    "testByFile": "cross-env NODE_ENV=test vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "miroir",
    "framework"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "loglevelnext": "6.0.0",
    "miroir-core": "*",
    "miroir-localcache-redux": "*",
    "miroir-app-admin": "*",
    "miroir-example-library": "*",
    "miroir-app-miroir": "*",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "miroir-store-filesystem": "*",
    "miroir-store-indexedDb": "*",
    "miroir-store-postgres": "*"
  },
  "peerDependenciesMeta": {
    "miroir-store-filesystem": {
      "optional": true
    },
    "miroir-store-indexedDb": {
      "optional": true
    },
    "miroir-store-postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/uuid": "11.0.0",
    "cross-env": "10.1.0",
    "miroir-env": "*",
    "tsup": "9.0.0",
    "vitest": "5.0.5"
  }
}
