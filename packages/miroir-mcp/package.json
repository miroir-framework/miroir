{
  "name": "@miroir-framework/mcp",
  "version": "0.5.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Model Context Protocol (MCP) server for Miroir Framework - exposes InstanceEndpoint actions as MCP tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "test": "cross-env NODE_ENV=test vitest run --bail=1",
    "testByFile": "cross-env NODE_ENV=test vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-mcp"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "miroir",
    "framework"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "loglevelnext": "6.0.0",
    "@miroir-framework/core": "*"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/uuid": "11.0.0",
    "cross-env": "10.1.0",
    "@miroir-framework/env": "*",
    "miroir-example-library": "*",
    "miroir-localcache-redux": "*",
    "@miroir-framework/store-filesystem": "*",
    "@miroir-framework/store-indexeddb": "*",
    "@miroir-framework/store-postgres": "*",
    "tsup": "9.0.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
