{
  "name": "miroir-mcp",
  "version": "0.5.0-rc.1",
  "description": "Model Context Protocol (MCP) server for Miroir Framework - exposes InstanceEndpoint actions as MCP tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "test": "cross-env NODE_ENV=test vitest run --poolOptions.threads.singleThread --bail=1",
    "testByFile": "cross-env NODE_ENV=test vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "miroir",
    "framework"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "express": "4.22.1",
    "loglevelnext": "6.0.0",
    "miroir-core": "*",
    "miroir-localcache-redux": "*",
    "miroir-app-admin": "*",
    "miroir-example-library": "*",
    "miroir-app-miroir": "*",
    "uuid": "11.1.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "miroir-store-filesystem": "*",
    "miroir-store-indexedDb": "*",
    "miroir-store-postgres": "*"
  },
  "peerDependenciesMeta": {
    "miroir-store-filesystem": {
      "optional": true
    },
    "miroir-store-indexedDb": {
      "optional": true
    },
    "miroir-store-postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.19.17",
    "@types/uuid": "10.0.0",
    "cross-env": "7.0.3",
    "miroir-env": "*",
    "tsup": "8.5.1",
    "vitest": "3.2.7"
  }
}
