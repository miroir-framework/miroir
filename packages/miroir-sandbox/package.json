  "license": "MIT",
  "main": "index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node --max-old-space-size=4096 ../../node_modules/vite/bin/vite.js build --emptyOutDir",
