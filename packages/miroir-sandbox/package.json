  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "loglevelnext": "6.0.0",
    "material-symbols": "0.47.5",
    "miroir-core": "*",
    "miroir-localcache-redux": "*",
    "miroir-react": "*",
    "miroir-store-bundled": "*",
    "miroir-store-indexedDb": "*",
    "miroir-app-admin": "*",
    "miroir-app-miroir": "*",
    "react": "19.3.0",
    "react-dom": "18.3.1",
    "react-redux": "9.3.0",
    "react-router-dom": "6.30.3",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "vite": "7.3.6",
    "vite-plugin-node-polyfills": "0.28.0"
  }
