{
  "name": "miroir-sandbox",
  "version": "0.5.0-rc.1",
  "description": "Static GitHub-Pages-deployable sandbox of the Miroir Framework",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "homepage": "https://github.com/miroir-framework/miroir/packages/miroir-sandbox/#readme",
