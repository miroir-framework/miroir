{
  "name": "miroir-test-app_deployment-postgres",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "Example PostgreSQL application assets for the Miroir Framework",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE.md",
    "package.json",
    "index.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/assets/**/*.json"
  ],
  "scripts": {
    "copy-files": "copyfiles -u 1 assets/**/*.json dist/assets",
    "build": "tsup",
    "devBuild": "npm run build",
    "extract-postgresManager-model": "tsx ./scripts/extract-postgresManager-model.ts",
    "test": "vitest run --poolOptions.threads.singleThread -t",
    "testByFile": "vitest run --poolOptions.forks.singleFork --reporter=verbose"
  },
  "nx": {
    "implicitDependencies": [
      "!miroir-core"
    ]
  },
  "devDependencies": {
    "copyfiles": "2.4.1",
    "miroir-core": "*",
    "miroir-store-filesystem": "*",
    "miroir-store-indexedDb": "*",
    "miroir-store-postgres": "*",
    "miroir-app-admin": "*",
    "miroir-app-miroir": "*",
    "tsup": "8.5.1",
    "tsx": "4.20.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
