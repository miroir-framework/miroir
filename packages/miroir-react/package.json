    "fast-deep-equal": "3.1.3",
    "lodash-es": "4.18.1",
    "miroir-app-admin": "*",
    "miroir-app-miroir": "*",
    "@miroir-framework/core": "*",
    "miroir-localcache-redux": "*",
    "react-error-boundary": "6.1.6",
    "react-markdown": "10.1.0",
