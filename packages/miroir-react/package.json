    "@mui/material": ">=5.17.1 <10",
    "formik": "^2.4.9",
    "react": ">=18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
