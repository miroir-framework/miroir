{
  "name": "miroir-react",
  "version": "0.5.0-rc.1",
  "description": "Reusable React context and theme system for the Miroir Framework",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "test": "vitest run --poolOptions.threads.singleThread -t",
    "testByFile": "vitest run --poolOptions.forks.singleFork --reporter=verbose"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.4",
    "@redux-devtools/core": "3.14.0",
    "@uiw/react-codemirror": "4.23.13",
    "miroir-core": "*",
    "miroir-localcache-redux": "*",
    "miroir-localcache-zustand": "*",
    "miroir-app-miroir": "*",
    "react-error-boundary": "4.1.2",
    "react-hook-form": "7.58.0",
    "react-markdown": "10.1.0",
    "react-redux": "8.1.3",
    "react-router-dom": "6.30.3",
    "react-select": "5.10.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/material": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "miroir-app-admin": "*",
    "miroir-test-app_deployment-library": "*",
    "tsup": "8.5.1",
    "vitest": "3.2.7"
  }
}
