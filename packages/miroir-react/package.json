{
  "name": "miroir-react",
  "version": "0.5.0-rc.1",
  "description": "Reusable React context and theme system for the Miroir Framework",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "devBuild": "npm run build",
    "test": "vitest run -t",
    "testByFile": "vitest run --maxWorkers=1 --reporter=verbose"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@redux-devtools/core": "5.0.0",
    "@uiw/react-codemirror": "4.25.12",
    "miroir-app-miroir": "*",
    "miroir-core": "*",
    "miroir-localcache-redux": "*",
    "miroir-localcache-zustand": "*",
    "react-error-boundary": "6.1.6",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "react-redux": "9.3.0",
    "react-router-dom": "6.30.3",
    "react-select": "5.10.2"
  },
  "peerDependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/material": "5.17.1",
    "react": ">=18.0.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "happy-dom": "20.14.5",
    "miroir-app-admin": "*",
    "miroir-example-library": "*",
    "tsup": "8.5.1",
    "vitest": "5.0.2"
  }
}
