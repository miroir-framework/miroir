{
  "name": "@miroir-framework/react",
  "version": "0.5.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Reusable React context and theme system for the Miroir Framework",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
