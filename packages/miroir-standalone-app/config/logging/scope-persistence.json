    "4_miroir-store-bundled_BundledStore": { "level": "DEBUG" },
    "4_miroir-store-bundled_BundledModelStoreSection": { "level": "DEBUG" },
    "4_miroir-store-bundled_BundledDataStoreSection": { "level": "DEBUG" }
  }
}
