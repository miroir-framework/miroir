{
  "$comment": "Scoped: persistence / store backends. Store sections and query runners at DEBUG; rest WARN. Use when an error involves a specific store (filesystem/indexedDb/postgres/mongodb) or SQL/extractor runners.",
  "defaultLevel": "WARN",
  "defaultTemplate": "[{{time}}] {{level}} {{name}} ### ",
  "specificLoggerOptions": {
    "4_miroir-core_PersistenceStoreController": { "level": "DEBUG" },
