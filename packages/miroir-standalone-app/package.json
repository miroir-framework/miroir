    "build": "node --max-old-space-size=8192 ../../node_modules/vite/bin/vite.js build --emptyOutDir",
    "devBuild": "npm run build",
    "coverageTour": "node ./scripts/coverage-tour.mjs",
    "selfTest": "node ./scripts/self-test.mjs",
    "loadTimings": "node ./scripts/load-timings.mjs",
    "test": "cross-env VITE_TEST_MODE='true' vitest run --bail=1 -t",
    "testByFile": "tsx ./scripts/test-by-file.ts",
    "testMiroir": "cross-env VITE_TEST_MODE='true' tsx ./scripts/test-miroir-runner.ts",
    "testByFileWithFullLog": "cross-env VITE_TEST_MODE='true' DEBUG='vite-node:*' vitest run --reporter=verbose --disable-console-intercept --bail=1"
