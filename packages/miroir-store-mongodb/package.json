{
  "name": "miroir-store-mongodb",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "The Miroir implementation for accessing MongoDB databases.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "dist/index.js",
  "type": "module",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "miroir-app-miroir": "*",
    "miroir-core": "*",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "copyfiles": "2.4.1",
    "rimraf": "6.1.3",
    "tsconfig-paths": "4.2.0",
    "tsup": "9.0.0"
  },
  "scripts": {
    "watch": "lerna watch --scope='miroir-store-mongodb' --include-dependencies -- lerna run build --scope='miroir-store-mongodb'",
    "build": "tsup",
    "devBuild": "npm run build",
    "copy-files": "copyfiles -u 1 src/**/*.json src/**/*.css dist/src",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroir-framework/miroir.git",
    "directory": "packages/miroir-store-mongodb"
  }
}
