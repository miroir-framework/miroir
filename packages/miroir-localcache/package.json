{
  "name": "miroir-localcache",
  "private": true,
  "version": "0.5.0-rc.1",
  "description": "The Miroir Local Cache interfaces and common implementation.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "watch": "lerna watch --scope='miroir-localcache-redux' --include-dependencies -- lerna run build --scope='miroir-localcache-redux'",
    "build": "tsup",
    "devBuild": "npm run build",
    "copy-files": "copyfiles -u 1 src/**/*.json src/**/*.css dist/src",
    "test": "cross-env NODE_ENV=test jest --verbose --debug --silent=false -t",
    "vitest": "vitest run --passWithNoTests"
  },
  "tsup": {
    "dts": true,
    "clean": false,
    "bundle": true,
    "treeshake": true,
    "target": "node20",
    "format": [
      "esm"
    ],
    "entry": [
      "src/index.ts"
    ],
    "external": [
      "fs",
      "react",
      "react-dom",
      "react-redux"
    ]
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "9.3.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "@teroneko/redux-saga-promise": "3.0.1",
    "diff": "8.0.3",
    "fast-deep-equal": "3.1.3",
    "http-proxy-middleware": "3.0.7",
    "lodash": "4.18.1",
    "miroir-core": "*",
    "redux-saga": "1.5.1",
    "typed-redux-saga": "1.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.14",
    "babel-loader": "10.1.1",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "happy-dom": "20.14.5",
    "miroir-localcache-redux": "*",
    "miroir-localcache-zustand": "*",
    "rimraf": "4.4.1",
    "rollup": "3.30.0",
    "ts-loader": "9.6.2",
    "tsconfig-paths": "4.2.0",
    "tsup": "8.5.1",
    "vite": "7.3.6",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "5.0.1",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1"
  },
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "license": "MIT"
}
