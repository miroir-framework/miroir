{
  "name": "miroir-framework",
  "version": "0.5.0-rc.1",
  "description": "Miroir Framework is a framework for building web applications.",
  "author": "Miroir Framework <miroir-framework@protonmail.com>",
  "homepage": "https://miroir-framework.github.io/miroir/",
  "bugs": "https://github.com/miroir-framework/miroir/issues",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "yaml": "2.9.1",
    "rxjs": "7.8.2",
    "lerna": {
      "js-yaml": "4.3.2",
      "pacote": "22.0.1",
      "handlebars": "4.7.10"
    },
    "nx": {
      "smol-toml": "1.7.1",
      "brace-expansion@5": "5.0.12",
      "axios": "1.20.0",
      "follow-redirects": "1.16.1"
    },
    "@connectrpc/connect-node": {
      "undici": "6.29.1"
    },
    "lodash-es": "4.18.1",
    "body-parser": "2.4.0",
    "iconv-lite": "0.7.3",
    "mime-db": "1.54.0",
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lerna": "10.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "zod": "4.6.7"
  },
  "scripts": {
    "postinstall": "node scripts/patch-tsup-baseurl.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "nonreg": "python scripts/run-nonreg.py",
    "nonreg:unit": "python scripts/run-nonreg.py --tier unit --run-all",
    "nonreg:default": "python scripts/run-nonreg.py --tier default --run-all",
    "nonreg:filesystem": "python scripts/run-nonreg.py --tier default --run-all --storage filesystem",
    "nonreg:indexedDb": "python scripts/run-nonreg.py --tier default --run-all --storage indexedDb",
    "nonreg:mongodb": "python scripts/run-nonreg.py --tier default --run-all --storage mongodb",
    "nonreg:zustand": "python scripts/run-nonreg.py --tier default --run-all --storage filesystem --local-cache zustand",
    "nonreg:fail-fast": "python scripts/run-nonreg.py --tier default --fail-fast",
    "lint": "node --test eslint-rules/miroir-layers.test.mjs eslint-rules/ml-adapter-imports.test.mjs eslint-rules/smell-lens.test.mjs eslint-rules/graduated-smells.test.mjs && eslint packages",
    "check:console": "python scripts/check_bare_console.py",
    "check:ml": "python scripts/check_ml_nomenclature.py",
    "check:uuids": "python scripts/check_instance_uuids.py",
    "smells": "python scripts/code_smells.py",
    "release:tag": "python scripts/release_tag.py",
    "release:tree": "python ci/release/release_version.py",
    "miroir-env": "node packages/miroir-env/dist/cli.js"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run build",
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "devBuild": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run devBuild",
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^devBuild"
        ]
      }
    }
  }
}
